diff --git a/lang/python/python-greenlet/Makefile b/lang/python/python-greenlet/Makefile
index dced8ade5..3cf01098c 100644
--- a/lang/python/python-greenlet/Makefile
+++ b/lang/python/python-greenlet/Makefile
@@ -8,19 +8,27 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=python-greenlet
-PKG_VERSION:=3.0.2
+PKG_VERSION:=3.5.4
 PKG_RELEASE:=1
 
 PYPI_NAME:=greenlet
-PKG_HASH:=1c1129bc47266d83444c85a8e990ae22688cf05fb20d7951fd2866007c2ba9bc
+PKG_HASH:=0232ae1de90a8e07867bb127d7a6ba2301e859145489f25cda8a6096dabe1d20
 
-PKG_MAINTAINER:=Jan Pavlinec <jan.pavlinec1@gmail.com>
+PKG_MAINTAINER:=Alexandru Ardelean <ardeleanalex@gmail.com>
 PKG_LICENSE:=MIT
 PKG_LICENSE_FILES:=LICENSE
-# FIXME: remove when GCC10 is the oldest supported compiler, or the issue goes away
-PKG_BUILD_FLAGS:=no-mips16
 
-HOST_BUILD_DEPENDS:=python3/host python-build/host python-installer/host python-wheel/host
+PKG_BUILD_DEPENDS:= \
+	python3/host \
+	python-setuptools/host \
+	python-wheel/host
