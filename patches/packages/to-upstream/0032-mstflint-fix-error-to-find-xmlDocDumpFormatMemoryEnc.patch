From 33c29ab8dd5ab8288385f63942cec57c5c9d23b9 Mon Sep 17 00:00:00 2001
From: Tomas Zak <tomas.zak@nic.cz>
Date: Thu, 6 Mar 2025 13:01:23 +0100
Subject: [PATCH] mstflint: fix error to find xmlDocDumpFormatMemoryEnc()
 function

Fix compilation error:
cannot find xml2 xmlDocDumpFormatMemoryEnc() function
---
 utils/mstflint/Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletions(-)

diff --git a/utils/mstflint/Makefile b/utils/mstflint/Makefile
index c775992c7..99494ca58 100644
--- a/utils/mstflint/Makefile
+++ b/utils/mstflint/Makefile
@@ -25,6 +25,7 @@ PKG_BUILD_PARALLEL:=1
 PKG_INSTALL:=1
 
 include $(INCLUDE_DIR)/package.mk
+include $(INCLUDE_DIR)/nls.mk
 
 define Package/mstflint
   SECTION:=Utilities
@@ -33,7 +34,7 @@ define Package/mstflint
   URL:=https://github.com/Mellanox/mstflint
   DEPENDS:=@!(mips||mips64||mipsel) \
     +libcurl +libexpat +liblzma +libopenssl \
-    +libsqlite3 +libstdcpp +libxml2 +zlib
+    +libsqlite3 +libstdcpp +libxml2 +zlib $(ICONV_DEPENDS)
 endef
 
 define Package/mstflint/description
-- 
2.39.5

