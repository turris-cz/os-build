From d61f3f6f5a4b438ea34c22e978219cad590fabd3 Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <michal.hrusecky@turris.com>
Date: Thu, 20 Mar 2025 10:50:09 +0100
Subject: [PATCH] watchcat: Add option to restart logical interface

Some interfaces are harder to restart then just link down/up. For
example VPNs or NCM modems.
---
 utils/watchcat/files/watchcat.init |  3 ++-
 utils/watchcat/files/watchcat.sh   | 27 ++++++++++++++++++++-------
 2 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/utils/watchcat/files/watchcat.init b/utils/watchcat/files/watchcat.init
index 75a8f0124..2a19a125e 100644
--- a/utils/watchcat/files/watchcat.init
+++ b/utils/watchcat/files/watchcat.init
@@ -39,6 +39,7 @@ config_watchcat() {
 	config_get forcedelay "$1" forcedelay "60"
 	config_get pingsize "$1" pingsize "standard"
 	config_get interface "$1" interface
+	config_get logical_interface "$1" logical_interface
 	config_get mmifacename "$1" mmifacename "null"
 	config_get_bool unlockbands "$1" unlockbands "0"
 	config_get_bool reset_failure_timer "$1" reset_failure_timer "0"
@@ -114,7 +115,7 @@ config_watchcat() {
 		procd_set_param command /usr/bin/watchcat.sh \
 			"restart_iface" "$period" "$pinghosts" "$pingperiod" \
 			"$pingsize" "$interface" "$mmifacename" "$unlockbands" \
-			"$addressfamily" "" "$reset_failure_timer"
+			"$logical_interface" "$addressfamily" "" "$reset_failure_timer"
 		procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
 		procd_close_instance
 		;;
diff --git a/utils/watchcat/files/watchcat.sh b/utils/watchcat/files/watchcat.sh
index 87c9678ca..de61f5687 100644
--- a/utils/watchcat/files/watchcat.sh
+++ b/utils/watchcat/files/watchcat.sh
@@ -164,6 +164,12 @@ watchcat_restart_network_iface() {
 	ifup "$network"
 }
 
+watchcat_restart_logical_network_iface() {
+       logger -p daemon.info -t "watchcat[$$]" "Restarting logical network interface: \"$1\"."
+       ifdown "$1"
+       ifup "$1"
+}
+
 watchcat_run_script() {
 	logger -p daemon.info -t "watchcat[$$]" "Running script \"$1\" for network interface: \"$2\"."
 	"$1" "$2"
@@ -182,8 +188,9 @@ watchcat_monitor_network() {
 	iface="$5"
 	mm_iface_name="$6"
 	mm_iface_unlock_bands="$7"
-	address_family="$8"
-	script="$9"
+	logical_interface="$8"
+	address_family="$9"
+	script="${10}"
 	ping_iface=""
 	restart_iface=""
 	reset_failure_timer=""
@@ -249,6 +256,8 @@ watchcat_monitor_network() {
 			else
 				if [ "$script" != "" ]; then
 					logger -p daemon.info -t "watchcat[$$]" "Could not reach $host via \"$iface\" for \"$((time_now - time_lastcheck_withinternet))\" seconds. Will run the script after \"$failure_period\" seconds of failed reachability"
+				elif [ "$logical_iface" != "" ]; then
+					logger -p daemon.info -t "watchcat[$$]" "Could not reach $host for \"$((time_now - time_lastcheck_withinternet))\" seconds. Restarting \"$logical_iface\" after reaching \"$failure_period\" seconds"
 				elif [ "$iface" != "" ]; then
 					logger -p daemon.info -t "watchcat[$$]" "Could not reach $host via \"$iface\" for \"$((time_now - time_lastcheck_withinternet))\" seconds. Will restart \"$iface\" after \"$failure_period\" seconds of failed reachability"
 				else
@@ -266,7 +275,9 @@ watchcat_monitor_network() {
 				if [ "$mm_iface_name" != "" ]; then
 					watchcat_restart_modemmanager_iface "$mm_iface_name" "$mm_iface_unlock_bands"
 				fi
-				if [ "$iface" != "" ]; then
+				if [ "$logical_iface" != "" ]; then
+					watchcat_restart_logical_network_iface "$logical_iface"
+				elif [ "$iface" != "" ]; then
 					watchcat_restart_network_iface "$iface" "$restart_iface"
 				else
 					watchcat_restart_all_network
@@ -384,8 +395,9 @@ restart_iface)
 	iface="$5"
 	mm_iface_name="$6"
 	mm_iface_unlock_bands="$7"
-	address_family="$8"
-	script="$9"
+	logical_interface="$8"
+	address_family="$9"
+	script="${10}"
 	reset_failure_timer=""
 	if [ "$#" -gt 9 ]; then
 		shift 9
@@ -405,8 +417,9 @@ run_script)
 	ping_frequency_interval="$3"
 	ping_size="$4"
 	iface="$5"
-	address_family="$6"
-	script="$7"
+	logical_interface="$6"
+	address_family="$7"
+	script="$8"
 	reset_failure_timer=""
 	if [ "$#" -gt 7 ]; then
 		shift 7
-- 
2.55.0

