From b674751cc0c5cb11a89f1cd68a35e61b1e63aadf Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <michal.hrusecky@turris.com>
Date: Thu, 30 Apr 2026 13:00:48 +0200
Subject: [PATCH] curl: Update to version 8.20.0

Fixes various security issues, see
https://curl.se/docs/vuln-8.12.1.html
---
 net/curl/Makefile                        |  4 ++--
 net/curl/patches/200-no_docs_tests.patch | 14 ++++++++------
 2 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/net/curl/Makefile b/net/curl/Makefile
index 3c4e3ef8d..268161ab7 100644
--- a/net/curl/Makefile
+++ b/net/curl/Makefile
@@ -9,13 +9,13 @@ include $(TOPDIR)/rules.mk
 include $(INCLUDE_DIR)/nls.mk
 
 PKG_NAME:=curl
-PKG_VERSION:=8.12.1
+PKG_VERSION:=8.20.0
 PKG_RELEASE:=1
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=https://github.com/curl/curl/releases/download/curl-$(subst .,_,$(PKG_VERSION))/ \
 	https://curl.se/download/
-PKG_HASH:=0341f1ed97a26c811abaebd37d62b833956792b7607ea3f15d001613c76de202
+PKG_HASH:=63fe2dc148ba0ceae89922ef838f7e5c946272c2e78b7c59fab4b79d3ce2b896
 
 PKG_LICENSE:=MIT
 PKG_LICENSE_FILES:=COPYING
diff --git a/net/curl/patches/200-no_docs_tests.patch b/net/curl/patches/200-no_docs_tests.patch
index 326e0335e..edec84e9b 100644
--- a/net/curl/patches/200-no_docs_tests.patch
+++ b/net/curl/patches/200-no_docs_tests.patch
@@ -1,15 +1,17 @@
---- a/Makefile.am
-+++ b/Makefile.am
-@@ -92,7 +92,7 @@ DISTCLEANFILES = buildinfo.txt
+Index: curl-8.20.0/Makefile.am
+===================================================================
+--- curl-8.20.0.orig/Makefile.am
++++ curl-8.20.0/Makefile.am
+@@ -71,7 +71,7 @@ DISTCLEANFILES = buildinfo.txt
  bin_SCRIPTS = curl-config
  
  SUBDIRS = lib docs src scripts
--DIST_SUBDIRS = $(SUBDIRS) tests packages include docs
-+DIST_SUBDIRS = $(SUBDIRS) packages include
+-DIST_SUBDIRS = $(SUBDIRS) tests projects include docs
++DIST_SUBDIRS = $(SUBDIRS) projects include
  
  pkgconfigdir = $(libdir)/pkgconfig
  pkgconfig_DATA = libcurl.pc
-@@ -188,12 +188,9 @@ rpm:
+@@ -141,12 +141,9 @@ check-docs:
  if BUILD_DOCS
  install-data-hook:
  	(cd include && $(MAKE) install)
-- 
2.54.0

