Subject: [PATCH] swanmon: fix missing lintl dependency

Fix missing dependency on lintl library
---
 utils/swanmon/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/utils/swanmon/Makefile b/utils/swanmon/Makefile
index c523ae634..731674fad 100644
--- a/utils/swanmon/Makefile
+++ b/utils/swanmon/Makefile
@@ -30,7 +30,7 @@ define Package/swanmon
   SECTION:=utils
   CATEGORY:=Utilities
   TITLE:=strongSwan monitoring tool
-  DEPENDS:=+davici +glib2 +libjson-c
+  DEPENDS:=+davici +glib2 +libjson-c $(INTL_DEPENDS)
 endef
 
 define Package/swanmon/description
