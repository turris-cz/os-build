From a5d410f79654ee849a9ac2d61cc29a617b368cae Mon Sep 17 00:00:00 2001
From: Tomas Zak <tomas.zak@turris.com>
Date: Thu, 6 Mar 2025 10:32:19 +0100
Subject: [PATCH] swanmon: fix missing lintl dependency

Fix missing dependency on lintl library
---
 utils/swanmon/Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/utils/swanmon/Makefile b/utils/swanmon/Makefile
index 6dd967573..6212649d9 100644
--- a/utils/swanmon/Makefile
+++ b/utils/swanmon/Makefile
@@ -24,13 +24,13 @@ PKG_BUILD_PARALLEL:=1
 
 include $(INCLUDE_DIR)/package.mk
 include $(INCLUDE_DIR)/cmake.mk
 include $(INCLUDE_DIR)/nls.mk
 
 define Package/swanmon
   SECTION:=utils
   CATEGORY:=Utilities
   TITLE:=strongSwan monitoring tool
-  DEPENDS:=+davici +glib2 +libjson-c
+  DEPENDS:=+davici +glib2 +libjson-c $(INTL_DEPENDS)
 endef
 
 define Package/swanmon/description
