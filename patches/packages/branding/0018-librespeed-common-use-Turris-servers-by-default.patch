From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Josef Schlehofer <pepe.schlehofer@gmail.com>
Date: Tue, 17 Nov 2026 08:56:30 +0100
Subject: [PATCH] librespeed-common: use Turris servers by default

Turris runs its own LibreSpeed servers, which reForis measured against
before 2.0.

Signed-off-by: Josef Schlehofer <pepe.schlehofer@gmail.com>
---
 utils/librespeed-common/files/librespeed.config | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/utils/librespeed-common/files/librespeed.config b/utils/librespeed-common/files/librespeed.config
index 3fa1afa0bf..cce74915d3 100644
--- a/utils/librespeed-common/files/librespeed.config
+++ b/utils/librespeed-common/files/librespeed.config
@@ -2,7 +2,7 @@ config librespeed 'main'
 	option interface 'wan'
 	option server 'auto'
 	option scheme 'auto'
-	option server_list ''
+	option server_list 'https://librespeed.turris.cz/servers.json'
 
 config librespeed 'schedule'
 	option enabled '0'
-- 
