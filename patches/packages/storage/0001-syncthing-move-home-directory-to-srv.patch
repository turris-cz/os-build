From a271effaaf8bcaf86f8175e5ad96969757d4c4fd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Karel=20Ko=C4=8D=C3=AD?= <cynerd@email.cz>
Date: Wed, 12 Aug 2020 16:35:07 +0200
Subject: [PATCH] syncthing: move home and logfile directories to /srv

Turris uses /srv and has support for easy mounting of drives to that
location.

[rebase, move logfile directory as well, update commit message
accordingly]
Signed-off-by: Šimon Bořek <simon.borek@nic.cz>
---
 utils/syncthing/files/syncthing.conf | 4 ++--
 utils/syncthing/files/syncthing.init | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/utils/syncthing/files/syncthing.conf b/utils/syncthing/files/syncthing.conf
index ad379f152..2fb3f1992 100644
--- a/utils/syncthing/files/syncthing.conf
+++ b/utils/syncthing/files/syncthing.conf
@@ -8,7 +8,7 @@ config syncthing 'syncthing'
 	# production. This filesystem must either support ownership/attributes or
 	# be readable/writable by the user specified in 'option user'.
 	# Consult syslog if things go wrong.
-	option home '/etc/syncthing'
+	option home '/srv/syncthing'
 
 	# Changes to "niceness"/maxprocs are not picked up by "reload_config" or by
 	# "restart": the service has to be stopped/started for those to take effect.
@@ -23,7 +23,7 @@ config syncthing 'syncthing'
 	# option user 'syncthing'
 	# option group 'syncthing'
 
-	option log_file '/var/log/syncthing.log'
+	option log_file '/srv/syncthing/syncthing.log'
 	# option log_level 'INFO'
 	option log_max_old_files '7'
 	# Size in bytes
diff --git a/utils/syncthing/files/syncthing.init b/utils/syncthing/files/syncthing.init
index 3981b0797..e87c45f04 100644
--- a/utils/syncthing/files/syncthing.init
+++ b/utils/syncthing/files/syncthing.init
@@ -29,8 +29,8 @@ start_service() {
 		'group:string:syncthing' \
 		'gui_address:string:http://0.0.0.0:8384' \
 		'gui_apikey:string' \
-		'home:string:/etc/syncthing' \
-		'log_file:string:/var/log/syncthing.log' \
+		'home:string:/srv/syncthing' \
+		'log_file:string:/srv/syncthing/syncthing.log' \
 		'logfile:string' \
 		'log_level:or("DEBUG", "INFO", "WARN", "ERROR"):INFO' \
 		'log_max_old_files:uinteger:7' \
-- 
2.47.3

