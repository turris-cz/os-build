From 32d5dec2ac85eac33b445b29bb295c213418a217 Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <michal.hrusecky@turris.com>
Date: Tue, 18 Mar 2025 23:33:05 +0100
Subject: [PATCH] target/mvebu Enable 10 Gbps Marvell PHY

It is used in Turris SFPs
---
 target/linux/mvebu/config-6.6 | 1 +
 1 file changed, 1 insertion(+)

diff --git a/target/linux/mvebu/config-6.6 b/target/linux/mvebu/config-6.6
index 37025e20b7..c8fab09980 100644
--- a/target/linux/mvebu/config-6.6
+++ b/target/linux/mvebu/config-6.6
@@ -244,6 +244,8 @@ CONFIG_MACH_MVEBU_V7=y
 CONFIG_MAGIC_SYSRQ=y
 CONFIG_MANGLE_BOOTARGS=y
 CONFIG_MARVELL_PHY=y
+CONFIG_MARVELL_10G_PHY=y
+CONFIG_AQUANTIA_PHY=y
 CONFIG_MDIO_BUS=y
 CONFIG_MDIO_DEVICE=y
 CONFIG_MDIO_DEVRES=y
