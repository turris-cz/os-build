From dbe03f6d5a7f8a35b354eb43ebae56b7a000192a Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <michal.hrusecky@turris.com>
Date: Fri, 13 Mar 2026 13:49:36 +0100
Subject: [PATCH] wifi-scripts: Restart Wi-Fi after new card appears

---
 package/network/config/wifi-scripts/Makefile                    | 2 +-
 .../wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect   | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/package/network/config/wifi-scripts/Makefile b/package/network/config/wifi-scripts/Makefile
index ae41f74949..f84522d8fd 100644
--- a/package/network/config/wifi-scripts/Makefile
+++ b/package/network/config/wifi-scripts/Makefile
@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=wifi-scripts
 PKG_VERSION:=1.0
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 PKG_LICENSE:=GPL-2.0
 
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
diff --git a/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect b/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect
index b865552661..d5a07159de 100644
--- a/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect
+++ b/package/network/config/wifi-scripts/files/etc/hotplug.d/ieee80211/10-wifi-detect
@@ -2,5 +2,6 @@
 
 [ "${ACTION}" = "add" ] && [ -f /etc/board.json ] && {
 	/sbin/wifi config
+	/sbin/wifi
 	ubus call network.wireless retry
 }
-- 
2.53.0

