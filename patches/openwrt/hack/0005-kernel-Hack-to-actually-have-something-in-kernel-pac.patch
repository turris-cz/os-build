From a35b2f5d7a8617ab24dd5ae403cd83959b7f8676 Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <Michal@Hrusecky.net>
Date: Tue, 20 Feb 2018 08:20:30 +0100
Subject: [PATCH] kernel: Hack to actually have something in kernel package

For some reason, default kernel package is empty, this should make it work
although the correct way is probably something completely different. Also
making kernel with dtbs fails for some reason. We need to dig deeper into
kernel build part and rework it a little bit.

The SDK has only part of the kernel tree and no kernel image, so skip
both there.
---
 package/kernel/linux/Makefile | 25 +++++++++++++++++++------
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/package/kernel/linux/Makefile b/package/kernel/linux/Makefile
index f524e21483..a111fd212d 100644
--- a/package/kernel/linux/Makefile
+++ b/package/kernel/linux/Makefile
@@ -41,8 +41,15 @@ endef
 define Build/Quilt
 endef
 
+ifndef SDK
 define Build/Compile
+	$(KERNEL_MAKE) $(KERNELNAME)
 endef
+else
+# The SDK has only part of the kernel tree and no kernel image
+define Build/Compile
+endef
+endif
 
 define KernelPackage/depends
 endef
@@ -58,14 +65,20 @@ define Package/kernel
   PKG_FLAGS:=nonshared
 endef
 
+ifndef SDK
 define Package/kernel/install
-	$(INSTALL_DIR) $(1)/$(MODULES_SUBDIR)
-	$(INSTALL_DATA) $(LINUX_DIR)/modules.builtin $(1)/$(MODULES_SUBDIR)
-	$(SED) 's,.*/,,' $(1)/$(MODULES_SUBDIR)/modules.builtin
-	strings $(LINUX_DIR)/modules.builtin.modinfo | \
-		grep -E -v "\.(file$(if CONFIG_MODULE_STRIPPED,|parmtype))=" | \
-		tr '\n' '\0' > $(1)/$(MODULES_SUBDIR)/modules.builtin.modinfo
+	$(INSTALL_DIR) "$(1)"/boot
+	$(foreach k, $(filter-out dtbs,$(KERNELNAME)), \
+		$(CP) $(LINUX_DIR)/arch/$(LINUX_KARCH)/boot/$(IMAGES_DIR)/$(k) "$(1)"/boot; \
+	)
+ifneq (,$(findstring Image.lzma,$(KERNEL_IMAGES)))
+	$(STAGING_DIR_HOST)/bin/lzma e "$(1)"/boot/Image "$(1)"/boot/Image.lzma
+endif
+	$(foreach d, $(DEVICE_DTS), \
+		$(CP) $(DTS_DIR)/$(d) "$(1)"/boot; \
+	)
 endef
+endif
 
 define Package/kernel/extra_provides
 	sed -e 's,.*/,,' $(LINUX_DIR)/modules.builtin;
-- 
