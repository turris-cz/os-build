From 1971272ceaa40315a84d82b1f3252529e1d9ce0b Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <Michal@Hrusecky.net>
Date: Mon, 12 Mar 2018 14:24:23 +0100
Subject: [PATCH] Drop Omnia sysupgrade and initramdisk

We don't need it and it breaks build.

Signed-off-by: Michal Hrusecky <Michal@Hrusecky.net>
---
 target/linux/mvebu/image/cortexa9.mk | 2 --
 1 file changed, 2 deletions(-)

diff --git a/target/linux/mvebu/image/cortexa9.mk b/target/linux/mvebu/image/cortexa9.mk
index 72d7f9dc2a..5da1e60477 100644
--- a/target/linux/mvebu/image/cortexa9.mk
+++ b/target/linux/mvebu/image/cortexa9.mk
@@ -109,8 +109,6 @@ define Device/cznic_turris-omnia
     kmod-mt7915-firmware partx-utils kmod-i2c-mux-pca954x kmod-leds-turris-omnia \
     kmod-turris-omnia-mcu kmod-gpio-button-hotplug omnia-eeprom omnia-mcu-firmware \
     omnia-mcutool kmod-dsa-mv88e6xxx
-  IMAGES := sysupgrade.img.gz
-  IMAGE/sysupgrade.img.gz := boot-scr | boot-img | sdcard-img | gzip | append-metadata
   SUPPORTED_DEVICES += armada-385-turris-omnia
   BOOT_SCRIPT := turris-omnia
 endef
-- 
2.50.0

