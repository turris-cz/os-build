From 68aa47f3546d935750239cdc38fb6ad1260745ab Mon Sep 17 00:00:00 2001
From: Stepan Henek <stepan.henek@nic.cz>
Date: Tue, 22 May 2018 16:42:19 +0200
Subject: [PATCH] odhcp6c: export DUID to /var/run/odhcp6c-duid.{ifname}

Signed-off-by: Stepan Henek <stepan.henek@nic.cz>
---
 .../ipv6/odhcp6c/patches/020-duid.path.patch  | 141 ++++++++++++++++++
 1 file changed, 141 insertions(+)
 create mode 100644 package/network/ipv6/odhcp6c/patches/020-duid.path.patch

diff --git a/package/network/ipv6/odhcp6c/patches/020-duid.path.patch b/package/network/ipv6/odhcp6c/patches/020-duid.path.patch
new file mode 100644
index 0000000000..c7587a250b
--- /dev/null
+++ b/package/network/ipv6/odhcp6c/patches/020-duid.path.patch
@@ -0,0 +1,141 @@
+From 1931de469511fab82a79eaead4936e28ba6e6c40 Mon Sep 17 00:00:00 2001
+From: Stepan Henek <stepan.henek@nic.cz>
+Date: Tue, 9 Aug 2022 09:17:16 +0200
+Subject: [PATCH] dhcpv6c: exportable DUID
+
+Adds a cmdline argument `-C <path>` which exports
+the current DUID (per interface) to a file.
+
+The main reason for this is that when DUID is generated
+by odhcp6c, it is not possible for other programs
+to detect which DUID is actually used.
+
+Signed-off-by: Stepan Henek <stepan.henek@nic.cz>
+---
+ src/dhcpv6.c  | 26 +++++++++++++++++++++++++-
+ src/odhcp6c.c | 10 ++++++++--
+ src/odhcp6c.h |  3 ++-
+ src/script.c  |  2 +-
+ 4 files changed, 36 insertions(+), 5 deletions(-)
+
+Index: odhcp6c-2026.06.04~daf4ec30/src/dhcpv6.c
+===================================================================
+--- odhcp6c-2026.06.04~daf4ec30.orig/src/dhcpv6.c
++++ odhcp6c-2026.06.04~daf4ec30/src/dhcpv6.c
+@@ -27,6 +27,7 @@
+ #include <resolv.h>
+ #include <signal.h>
+ #include <stdbool.h>
++#include <stdio.h>
+ #include <stdlib.h>
+ #include <string.h>
+ #include <sys/ioctl.h>
+@@ -564,7 +565,7 @@ static uint32_t dhcpv6_generate_iface_ia
+ 	return iaid;
+ }
+ 
+-int init_dhcpv6(const char *ifname)
++int init_dhcpv6(const char *ifname, const char *duid_path)
+ {
+ 	config_dhcp = config_dhcp_get();
+ 
+@@ -656,6 +657,29 @@ int init_dhcpv6(const char *ifname)
+ 		odhcp6c_add_state(STATE_CLIENT_ID, duid, sizeof(duid));
+ 	}
+ 
++	// Write duid to path
++	if (duid_path) {
++		// read duid
++		size_t duid_len;
++		void *duid = odhcp6c_get_state(STATE_CLIENT_ID, &duid_len);
++		char duid_buf[duid_len * 2 + 1];
++		script_hexlify(duid_buf, &((uint8_t *) duid)[4], duid_len - 4);
++		duid_buf[duid_len * 2] = 0;
++
++		// generate path
++		char file_path[strlen(duid_path) + strlen(ifname) + 2];
++		sprintf(file_path, "%s.%s", duid_path, ifname);
++
++		// write to file
++		FILE *fp = fopen(file_path, "w");
++		if (fp) {
++			fprintf(fp, "%s\n", duid_buf);
++			fclose(fp);
++		} else {
++			syslog(LOG_ERR, "Failed to write DUID '%s' into file '%s'!", duid_buf, file_path);
++		};
++	}
++
+ 	// Create ORO
+ 	if (!(client_options & DHCPV6_STRICT_OPTIONS)) {
+ 		uint16_t oro[] = {
+Index: odhcp6c-2026.06.04~daf4ec30/src/odhcp6c.c
+===================================================================
+--- odhcp6c-2026.06.04~daf4ec30.orig/src/odhcp6c.c
++++ odhcp6c-2026.06.04~daf4ec30/src/odhcp6c.c
+@@ -224,6 +224,7 @@ int main(_o_unused int argc, char* const
+ 	// Allocate resources
+ 	const char *pidfile = NULL;
+ 	const char *script = "/lib/netifd/dhcpv6.script";
++	const char *duid_path = "/var/run/odhcp6c-duid";
+ 	ssize_t l;
+ 	uint8_t buf[134], *o_data;
+ 	int optidx;
+@@ -246,7 +247,7 @@ int main(_o_unused int argc, char* const
+ 
+ 	atexit(odhcp6c_cleanup);
+ 
+-	while ((c = getopt_long(argc, argv, "SDN:V:P:FB:c:i:r:Ru:Ux:s:EkK:t:C:m:Lhedp:favl:", opt_long, &optidx)) != -1) {
++	while ((c = getopt_long(argc, argv, "SDN:V:P:FB:c:G:i:r:Ru:Ux:s:EkK:t:C:m:Lhedp:favl:", opt_long, &optidx)) != -1) {
+ 		switch (c) {
+ 		case 0:
+ 			break;
+@@ -361,6 +362,10 @@ int main(_o_unused int argc, char* const
+ 			}
+ 			break;
+ 
++		case 'G':
++			duid_path = optarg;
++			break;
++
+ 		case 'i':
+ 			if (!strcmp(optarg, DHCPV6_IFACEID_EUI64)) {
+ 				ra_ifid_mode = RA_IFID_EUI64;
+@@ -617,7 +622,7 @@ int main(_o_unused int argc, char* const
+ 			odhcp6c_get_state(STATE_ORO, &oro_len);
+ 			config_dhcp->oro_user_cnt = oro_len / sizeof(uint16_t);
+ 
+-			if (init_dhcpv6(ifname)) {
++			if (init_dhcpv6(ifname, duid_path)) {
+ 				error("failed to initialize: %s", strerror(errno));
+ 				return 1;
+ 			}
+@@ -884,6 +889,7 @@ static int usage(void)
+ 	"			-x 0x1f4:ABBA - option 500\n"
+ 	"			-x 202:'\"file\"' - option 202\n"
+ 	"	-c <clientid>	Override client-ID (base-16 encoded 16-bit type + value)\n"
++	"	-G <path>	Export used client-ID to specified path\n"
+ 	"	-i <iface-id>	Use a custom interface identifier for RA handling\n"
+ 	"	-r <options>	Options to be requested (comma-separated)\n"
+ 	"	-R		Do not request any options except those specified with -r\n"
+Index: odhcp6c-2026.06.04~daf4ec30/src/odhcp6c.h
+===================================================================
+--- odhcp6c-2026.06.04~daf4ec30.orig/src/odhcp6c.h
++++ odhcp6c-2026.06.04~daf4ec30/src/odhcp6c.h
+@@ -558,7 +558,7 @@ struct odhcp6c_opt_cfg {
+ 	int strict_rfc7550;
+ };
+ 
+-int init_dhcpv6(const char *ifname);
++int init_dhcpv6(const char *ifname, const char *duid_path);
+ int dhcpv6_get_ia_mode(void);
+ int dhcpv6_promote_server_cand(void);
+ int dhcpv6_send_request(enum dhcpv6_msg type);
+@@ -586,6 +586,7 @@ int ra_get_retransmit(void);
+ void notify_state_change(const char *status, int delay, bool resume);
+ 
+ int script_init(const char *path, const char *ifname);
++void script_hexlify(char *dst, const uint8_t *src, size_t len);
+ ssize_t script_unhexlify(uint8_t *dst, size_t len, const char *src);
+ void script_hexlify(char *dst, const uint8_t *src, size_t len);
+ void script_call(const char *status, int delay, bool resume);
-- 
2.47.3

