From 058844790c9d5da9845d87d094ee23a6939b0910 Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <michal.hrusecky@turris.com>
Date: Mon, 18 Nov 2024 11:24:30 +0100
Subject: [PATCH] target/linux: Add support for Meig SLM770A

---
 .../hack-5.15/999-meig-slm770a-support.patch  | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)
 create mode 100644 target/linux/generic/hack-5.15/999-meig-slm770a-support.patch

diff --git a/target/linux/generic/hack-5.15/999-meig-slm770a-support.patch b/target/linux/generic/hack-5.15/999-meig-slm770a-support.patch
new file mode 100644
index 0000000000..330ab71eaf
--- /dev/null
+++ b/target/linux/generic/hack-5.15/999-meig-slm770a-support.patch
@@ -0,0 +1,21 @@
+Index: linux-5.15.171/drivers/usb/serial/option.c
+===================================================================
+--- linux-5.15.171.orig/drivers/usb/serial/option.c
++++ linux-5.15.171/drivers/usb/serial/option.c
+@@ -629,6 +629,8 @@ static void option_instat_callback(struc
+ #define MEIGSMART_PRODUCT_SRM825L		0x4d22
+ /* MeiG Smart SLM320 based on UNISOC UIS8910 */
+ #define MEIGSMART_PRODUCT_SLM320		0x4d41
++/* MeiG Smart SLM770A based on ASR1803 */
++#define MEIGSMART_PRODUCT_SLM770A		0x4d57
+ 
+ /* Device flags */
+ 
+@@ -2392,6 +2394,7 @@ static const struct usb_device_id option
+ 	{ USB_DEVICE_AND_INTERFACE_INFO(UNISOC_VENDOR_ID, TOZED_PRODUCT_LT70C, 0xff, 0, 0) },
+ 	{ USB_DEVICE_AND_INTERFACE_INFO(UNISOC_VENDOR_ID, LUAT_PRODUCT_AIR720U, 0xff, 0, 0) },
+ 	{ USB_DEVICE_AND_INTERFACE_INFO(MEIGSMART_VENDOR_ID, MEIGSMART_PRODUCT_SLM320, 0xff, 0, 0) },
++	{ USB_DEVICE_AND_INTERFACE_INFO(MEIGSMART_VENDOR_ID, MEIGSMART_PRODUCT_SLM770A, 0xff, 0, 0) },
+ 	{ USB_DEVICE_AND_INTERFACE_INFO(MEIGSMART_VENDOR_ID, MEIGSMART_PRODUCT_SRM825L, 0xff, 0xff, 0x30) },
+ 	{ USB_DEVICE_AND_INTERFACE_INFO(MEIGSMART_VENDOR_ID, MEIGSMART_PRODUCT_SRM825L, 0xff, 0xff, 0x40) },
+ 	{ USB_DEVICE_AND_INTERFACE_INFO(MEIGSMART_VENDOR_ID, MEIGSMART_PRODUCT_SRM825L, 0xff, 0xff, 0x60) },
diff --git a/package/network/utils/comgt/files/ncm.json b/package/network/utils/comgt/files/ncm.json
index 5f68b13496..9e7ca8344b 100644
--- a/package/network/utils/comgt/files/ncm.json
+++ b/package/network/utils/comgt/files/ncm.json
@@ -113,6 +113,16 @@
 		"connect": "AT+CGATT=1",
 		"disconnect": "AT+CGATT=0"
 	},
+	"meig": {
+		"initialize": [
+			"AT+CFUN=1"
+		],
+		"configure": [
+			"AT+CGDCONT=${profile},\\\"${pdptype}\\\",\\\"${apn}\\\",\\\"\\\",0,0"
+		],
+		"connect": "AT+CGACT=1,${profile}",
+		"disconnect": "AT+CGACT=0,${profile}"
+	},
 	"\"mikrotik\"": {
 		"configure": [
 			"AT+CFUN=4",
