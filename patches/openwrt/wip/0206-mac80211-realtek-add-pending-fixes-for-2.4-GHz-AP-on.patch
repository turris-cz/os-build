diff --git a/package/kernel/mac80211/patches/rtl/054-wifi-rtw88-8822b-Relax-ETSI-EDCCA-threshold-on-2.4-GHz.patch b/package/kernel/mac80211/patches/rtl/054-wifi-rtw88-8822b-Relax-ETSI-EDCCA-threshold-on-2.4-GHz.patch
new file mode 100644
index 0000000000..69881ebb8d
--- /dev/null
+++ b/package/kernel/mac80211/patches/rtl/054-wifi-rtw88-8822b-Relax-ETSI-EDCCA-threshold-on-2.4-GHz.patch
@@ -0,0 +1,58 @@
+From 9ab0b3ce8c764087e9b3c1c19290b24be333abfa Mon Sep 17 00:00:00 2001
+From: Josef Schlehofer <pepe.schlehofer@gmail.com>
+Date: Sun, 11 Oct 2026 18:13:14 +0200
+Subject: [PATCH] wifi: rtw88: 8822b: Relax ETSI EDCCA threshold on 2.4 GHz
+
+The RTL8822B has no firmware-managed adaptivity, so rtw88 sets
+the EDCCA thresholds in the driver. Under ETSI, the current rule
+uses L2H = min(IGI, 36), at most about -74 dBm.
+
+On a TP-Link Archer T4U v3 (RTL8812BU) operating as a 2.4 GHz AP,
+in-band energy, mostly from the adapter's own USB 3 link, kept IGI
+at 0x2a and L2H at 36. The AP was not seen in any of 5 scans, and
+the driver reported "failed to get tx report from firmware".
+
+With min(max(IGI + 8, 48), 50), the AP was seen in 4/5 scans on the
+same port and boot (16/19 across repeated runs), with no TX report
+failures and no change in the false alarm rate.
+
+EN 300 328 V2.2.2 tests detection at -70 dBm/MHz for a 20 dBm EIRP
+transmitter, about -57 dBm over 20 MHz.
+
+Use the normal threshold, max(IGI + 8, 48), on 2.4 GHz under ETSI,
+capped at 50 (nominally -60 dBm). Keep the existing rule on 5 GHz
+and in JP.
+
+Signed-off-by: Josef Schlehofer <pepe.schlehofer@gmail.com>
+Link: https://lore.kernel.org/linux-wireless/20261011204509.46062-1-pepe.schlehofer@gmail.com/
+---
+ drivers/net/wireless/realtek/rtw88/rtw8822b.c | 6 ++++++
+ drivers/net/wireless/realtek/rtw88/rtw8822b.h | 2 ++
+ 2 files changed, 8 insertions(+)
+
+--- a/drivers/net/wireless/realtek/rtw88/rtw8822b.c
++++ b/drivers/net/wireless/realtek/rtw88/rtw8822b.c
+@@ -1561,6 +1561,12 @@ static void rtw8822b_adaptivity(struct r
+ 	if (dm_info->edcca_mode == RTW_EDCCA_NORMAL) {
+ 		l2h = max_t(s8, igi + EDCCA_IGI_L2H_DIFF, EDCCA_TH_L2H_LB);
+ 		h2l = l2h - EDCCA_L2H_H2L_DIFF_NORMAL;
++	} else if (rtwdev->regd.dfs_region == NL80211_DFS_ETSI &&
++		   rtwdev->hal.current_band_type == RTW_BAND_2G) {
++		/* follow the normal threshold, capped for EN 300 328 */
++		l2h = max_t(s8, igi + EDCCA_IGI_L2H_DIFF, EDCCA_TH_L2H_LB);
++		l2h = min_t(s8, l2h, RTW8822B_EDCCA_ETSI_2G);
++		h2l = l2h - EDCCA_L2H_H2L_DIFF;
+ 	} else {
+ 		l2h = min_t(s8, igi, dm_info->l2h_th_ini);
+ 		h2l = l2h - EDCCA_L2H_H2L_DIFF;
+--- a/drivers/net/wireless/realtek/rtw88/rtw8822b.h
++++ b/drivers/net/wireless/realtek/rtw88/rtw8822b.h
+@@ -151,6 +151,8 @@ _rtw_write32s_mask(struct rtw_dev *rtwde
+ 
+ #define RTW8822B_EDCCA_MAX	0x7f
+ #define RTW8822B_EDCCA_SRC_DEF	1
++/* nominally -60 dBm: 3 dB below the EN 300 328 level at 20 dBm e.i.r.p. */
++#define RTW8822B_EDCCA_ETSI_2G	50
+ #define REG_HTSTFWT	0x800
+ #define REG_RXCCAMSK	0x814
+ #define REG_L1WT	0x83c
diff --git a/package/kernel/mac80211/patches/rtl/055-wifi-rtw88-usb-Download-the-reserved-page-synchronously.patch b/package/kernel/mac80211/patches/rtl/055-wifi-rtw88-usb-Download-the-reserved-page-synchronously.patch
new file mode 100644
index 0000000000..e276fd2431
--- /dev/null
+++ b/package/kernel/mac80211/patches/rtl/055-wifi-rtw88-usb-Download-the-reserved-page-synchronously.patch
@@ -0,0 +1,164 @@
+From 39abfddbc3a938b2659db9ee6b269cde440e9b51 Mon Sep 17 00:00:00 2001
+From: Mohammed Afifi <i.mafifi17@gmail.com>
+Date: Sun, 11 Oct 2026 11:59:37 +0200
+Subject: [PATCH v5] wifi: rtw88: usb: Download the reserved page synchronously
+
+In AP mode the reserved page (which contains the beacon) is downloaded
+to the chip by rtw_fw_write_data_rsvd_page(). That function writes the
+data via rtw_hci_write_data_rsvd_page() and then immediately polls the
+hardware BCN_VALID bit to confirm the firmware accepted the beacon.
+
+On USB, rtw_usb_write_data_rsvd_page() ends up in rtw_usb_write_port(),
+which submits the URB with usb_submit_urb() and returns as soon as the
+transfer is queued. The completion callback only frees the skb. As a
+result the BCN_VALID poll can run while the beacon is still in flight
+on the bus, and the poll times out even though the download itself is
+fine.
+
+This shows up as:
+
+  rtw_8822bu: error beacon valid
+  rtw_8822bu: failed to download drv rsvd page
+
+The failure is intermittent because the poll retries sometimes cover
+the transfer time. It occurs in bursts when something triggers repeated
+beacon updates, such as stations associating and disassociating.
+
+Fix this by making rtw_usb_write_data() wait for the URB to complete
+when it's called from rtw_usb_write_data_rsvd_page(). The new
+rtw_usb_write_port_sync() waits the same way usb_bulk_msg() does: if
+the URB doesn't complete within 5 seconds, it is killed before the
+function returns, so the completion handler can't run after that.
+usb_bulk_msg() itself is not used because it can't set URB_ZERO_PACKET,
+which rtw_usb_write_port() sets for every bulk out transfer.
+
+Only the reserved page path is made synchronous; the normal data TX
+path and the H2C path are left untouched, so throughput is unaffected.
+The chips with a 3081 WCPU also download their firmware through
+rtw_usb_write_data_rsvd_page(), so those chunks are now sent
+synchronously as well.
+
+The reserved page download runs in process context under rtwdev->mutex,
+so sleeping there is safe.
+
+Closes: https://github.com/lwfinger/rtw88/issues/451
+Signed-off-by: Mohammed Afifi <i.mafifi17@gmail.com>
+Signed-off-by: Bitterblue Smith <rtl8821cerfe2@gmail.com>
+Co-developed-by: Josef Schlehofer <pepe.schlehofer@gmail.com>
+Signed-off-by: Josef Schlehofer <pepe.schlehofer@gmail.com>
+Acked-by: Ping-Ke Shih <pkshih@realtek.com>
+Link: https://lore.kernel.org/linux-wireless/20261013033737.6761-1-pepe.schlehofer@gmail.com/
+---
+ drivers/net/wireless/realtek/rtw88/usb.c | 66 +++++++++++++++++++++---
+ 1 file changed, 58 insertions(+), 8 deletions(-)
+
+--- a/drivers/net/wireless/realtek/rtw88/usb.c
++++ b/drivers/net/wireless/realtek/rtw88/usb.c
+@@ -388,6 +388,51 @@ static int rtw_usb_write_port(struct rtw
+ 	return ret;
+ }
+ 
++static void rtw_usb_write_port_sync_complete(struct urb *urb)
++{
++	complete(urb->context);
++}
++
++static int rtw_usb_write_port_sync(struct rtw_dev *rtwdev, u8 qsel,
++				   struct sk_buff *skb)
++{
++	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
++	struct usb_device *usbd = rtwusb->udev;
++	int ep = qsel_to_ep(rtwusb, qsel);
++	DECLARE_COMPLETION_ONSTACK(done);
++	unsigned int pipe;
++	struct urb *urb;
++	int ret;
++
++	if (ep < 0)
++		return ep;
++
++	pipe = usb_sndbulkpipe(usbd, rtwusb->out_ep[ep]);
++	urb = usb_alloc_urb(0, GFP_KERNEL);
++	if (!urb)
++		return -ENOMEM;
++
++	usb_fill_bulk_urb(urb, usbd, pipe, skb->data, skb->len,
++			  rtw_usb_write_port_sync_complete, &done);
++	urb->transfer_flags |= URB_ZERO_PACKET;
++	ret = usb_submit_urb(urb, GFP_KERNEL);
++	if (ret)
++		goto out;
++
++	if (wait_for_completion_timeout(&done, secs_to_jiffies(5))) {
++		ret = urb->status;
++	} else {
++		/* timed out; usb_kill_urb() waits for the completion handler */
++		usb_kill_urb(urb);
++		ret = urb->status == -ENOENT ? -ETIMEDOUT : urb->status;
++	}
++
++out:
++	usb_free_urb(urb);
++
++	return ret;
++}
++
+ static bool rtw_usb_tx_agg_skb(struct rtw_usb *rtwusb, struct sk_buff_head *list)
+ {
+ 	struct rtw_dev *rtwdev = rtwusb->rtwdev;
+@@ -500,13 +545,13 @@ static void rtw_usb_write_port_complete(
+ 
+ static int rtw_usb_write_data(struct rtw_dev *rtwdev,
+ 			      struct rtw_tx_pkt_info *pkt_info,
+-			      u8 *buf)
++			      u8 *buf, bool sync)
+ {
+ 	const struct rtw_chip_info *chip = rtwdev->chip;
+ 	struct sk_buff *skb;
+ 	unsigned int size;
+ 	u8 qsel;
+-	int ret = 0;
++	int ret;
+ 
+ 	size = pkt_info->tx_pkt_size;
+ 	qsel = pkt_info->qsel;
+@@ -522,12 +567,16 @@ static int rtw_usb_write_data(struct rtw
+ 	rtw_tx_fill_tx_desc(rtwdev, pkt_info, skb);
+ 	rtw_tx_fill_txdesc_checksum(rtwdev, pkt_info, skb->data);
+ 
+-	ret = rtw_usb_write_port(rtwdev, qsel, skb,
+-				 rtw_usb_write_port_complete, skb);
+-	if (unlikely(ret)) {
++	if (sync)
++		ret = rtw_usb_write_port_sync(rtwdev, qsel, skb);
++	else
++		ret = rtw_usb_write_port(rtwdev, qsel, skb,
++					 rtw_usb_write_port_complete, skb);
++	if (unlikely(ret))
+ 		rtw_err(rtwdev, "failed to do USB write, ret=%d\n", ret);
++
++	if (ret || sync)
+ 		dev_kfree_skb_any(skb);
+-	}
+ 
+ 	return ret;
+ }
+@@ -543,7 +592,8 @@ static int rtw_usb_write_data_rsvd_page(
+ 	pkt_info.offset = chip->tx_pkt_desc_sz;
+ 	pkt_info.ls = true;
+ 
+-	return rtw_usb_write_data(rtwdev, &pkt_info, buf);
++	/* the caller checks BCN_VALID right after this, so wait for the URB */
++	return rtw_usb_write_data(rtwdev, &pkt_info, buf, true);
+ }
+ 
+ static int rtw_usb_write_data_h2c(struct rtw_dev *rtwdev, u8 *buf, u32 size)
+@@ -553,7 +603,7 @@ static int rtw_usb_write_data_h2c(struct
+ 	pkt_info.tx_pkt_size = size;
+ 	pkt_info.qsel = TX_DESC_QSEL_H2C;
+ 
+-	return rtw_usb_write_data(rtwdev, &pkt_info, buf);
++	return rtw_usb_write_data(rtwdev, &pkt_info, buf, false);
+ }
+ 
+ static u8 rtw_usb_tx_queue_mapping_to_qsel(struct sk_buff *skb)
-- 
