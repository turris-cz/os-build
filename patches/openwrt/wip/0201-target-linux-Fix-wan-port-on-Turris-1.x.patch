From 0c7c6bac997d82dfffa62c4c8f5b7b320aebbc83 Mon Sep 17 00:00:00 2001
From: Michal Hrusecky <michal.hrusecky@turris.com>
Date: Tue, 4 Mar 2025 17:21:56 +0100
Subject: [PATCH] target/linux: Fix wan port on Turris 1.x

---
 ...rbid-management-frames-access-to-int.patch | 149 ++++++++++++++++++
 1 file changed, 149 insertions(+)
 create mode 100644 target/linux/generic/pending-6.6/9001-net-dsa-qca8k-forbid-management-frames-access-to-int.patch

diff --git a/target/linux/generic/pending-6.6/9001-net-dsa-qca8k-forbid-management-frames-access-to-int.patch b/target/linux/generic/pending-6.6/9001-net-dsa-qca8k-forbid-management-frames-access-to-int.patch
new file mode 100644
index 0000000000..daa574b66a
--- /dev/null
+++ b/target/linux/generic/pending-6.6/9001-net-dsa-qca8k-forbid-management-frames-access-to-int.patch
@@ -0,0 +1,149 @@
+From 6d0b9fd16b3fd9ae09803920029272d5caef1263 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Marek=20Beh=C3=BAn?= <kabel@kernel.org>
+Date: Thu, 27 Feb 2025 15:26:53 +0100
+Subject: [PATCH] net: dsa: qca8k: forbid management frames access to internal
+ PHYs if another device is on the MDIO bus
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Completely forbid access to internal switch PHYs via management frames
+if there is another MDIO device on the MDIO bus besides the QCA8K
+switch.
+
+When internal PHYs are accessed via management frames, it seems that
+internally the switch core translates the management frame requests to
+MDIO and communicates with the internal PHYs via MDIO. This
+communication leaks outside to the MDC and MDIO pins. If there is
+another PHY device connected on the MDIO bus besides the QCA8K switch,
+and the kernel tries to communicate with the PHY at the same time, the
+communication gets corrupted.
+
+This makes the WAN PHY break on the Turris 1.x device.
+
+In commit 526c8ee04bdb ("net: dsa: qca8k: fix potential MDIO bus
+conflict when accessing internal PHYs via management frames") we tried
+to solve this issue by locking access to the MDIO bus when accessing
+internal PHYs via management frames. It seems that the bug still
+prevails, though, a and we are not able to determine why. Therefore we
+need to fix this issue in this way.
+
+Fixes: 526c8ee04bdb ("net: dsa: qca8k: fix potential MDIO bus conflict when accessing internal PHYs via management frames")
+Signed-off-by: Marek Behún <kabel@kernel.org>
+---
+ drivers/net/dsa/qca/qca8k-8xxx.c | 51 +++++++++++++++++++++++++-------
+ drivers/net/dsa/qca/qca8k.h      |  1 +
+ 2 files changed, 41 insertions(+), 11 deletions(-)
+
+diff --git a/drivers/net/dsa/qca/qca8k-8xxx.c b/drivers/net/dsa/qca/qca8k-8xxx.c
+index 384ae32c05b1..2cd89711b3dd 100644
+--- a/drivers/net/dsa/qca/qca8k-8xxx.c
++++ b/drivers/net/dsa/qca/qca8k-8xxx.c
+@@ -633,6 +633,9 @@ qca8k_phy_eth_command(struct qca8k_priv *priv, bool read, int phy,
+ 	if (regnum >= QCA8K_MDIO_MASTER_MAX_REG)
+ 		return -EINVAL;
+ 
++	if (!priv->can_access_phys_over_mgmt)
++		return -EBUSY;
++
+ 	mgmt_eth_data = &priv->mgmt_eth_data;
+ 
+ 	write_val = QCA8K_MDIO_MASTER_BUSY | QCA8K_MDIO_MASTER_EN |
+@@ -666,15 +669,6 @@ qca8k_phy_eth_command(struct qca8k_priv *priv, bool read, int phy,
+ 		goto err_read_skb;
+ 	}
+ 
+-	/* It seems that accessing the switch's internal PHYs via management
+-	 * packets still uses the MDIO bus within the switch internally, and
+-	 * these accesses can conflict with external MDIO accesses to other
+-	 * devices on the MDIO bus.
+-	 * We therefore need to lock the MDIO bus onto which the switch is
+-	 * connected.
+-	 */
+-	mutex_lock_nested(&priv->bus->mdio_lock, MDIO_MUTEX_NESTED);
+-
+ 	/* Actually start the request:
+ 	 * 1. Send mdio master packet
+ 	 * 2. Busy Wait for mdio master command
+@@ -687,7 +681,6 @@ qca8k_phy_eth_command(struct qca8k_priv *priv, bool read, int phy,
+ 	mgmt_master = priv->mgmt_master;
+ 	if (!mgmt_master) {
+ 		mutex_unlock(&mgmt_eth_data->mutex);
+-		mutex_unlock(&priv->bus->mdio_lock);
+ 		ret = -EINVAL;
+ 		goto err_mgmt_master;
+ 	}
+@@ -775,7 +768,6 @@ qca8k_phy_eth_command(struct qca8k_priv *priv, bool read, int phy,
+ 				    QCA8K_ETHERNET_TIMEOUT);
+ 
+ 	mutex_unlock(&mgmt_eth_data->mutex);
+-	mutex_unlock(&priv->bus->mdio_lock);
+ 
+ 	return ret;
+ 
+@@ -943,6 +935,39 @@ qca8k_legacy_mdio_read(struct mii_bus *slave_bus, int port, int regnum)
+ 	return qca8k_internal_mdio_read(slave_bus, port, regnum);
+ }
+ 
++static int qca8k_mdio_determine_access_over_eth(struct qca8k_priv *priv)
++{
++	struct device_node *parent = of_get_parent(priv->dev->of_node);
++	int addr = to_mdio_device(priv->dev)->addr;
++	bool result = true;
++	u32 reg;
++	int err;
++
++	/* It seems that accessing the switch's internal PHYs via management
++	 * packets still uses the MDIO bus within the switch internally, and
++	 * these accesses can conflict with external MDIO accesses to other
++	 * devices on the MDIO bus.
++	 *
++	 * Determine whether there are other devices on the MDIO bus besides
++	 * the switch, and if there are, forbid access to the internal PHYs
++	 * via management frames.
++	 */
++	for_each_available_child_of_node_scoped(parent, sibling) {
++		err = of_property_read_u32(sibling, "reg", &reg);
++		if (err)
++			return err;
++
++		if (reg != addr) {
++			result = false;
++			break;
++		}
++	}
++
++	priv->can_access_phys_over_mgmt = result;
++
++	return 0;
++}
++
+ static int
+ qca8k_mdio_register(struct qca8k_priv *priv)
+ {
+@@ -951,6 +976,10 @@ qca8k_mdio_register(struct qca8k_priv *priv)
+ 	struct mii_bus *bus;
+ 	int err;
+ 
++	err = qca8k_mdio_determine_access_over_eth(priv);
++	if (err)
++		return err;
++
+ 	mdio = of_get_child_by_name(priv->dev->of_node, "mdio");
+ 
+ 	bus = devm_mdiobus_alloc(ds->dev);
+diff --git a/drivers/net/dsa/qca/qca8k.h b/drivers/net/dsa/qca/qca8k.h
+index 8f88b7db384d..f3692225eb16 100644
+--- a/drivers/net/dsa/qca/qca8k.h
++++ b/drivers/net/dsa/qca/qca8k.h
+@@ -461,6 +461,7 @@ struct qca8k_priv {
+ 	struct net_device *mgmt_master; /* Track if mdio/mib Ethernet is available */
+ 	struct qca8k_mgmt_eth_data mgmt_eth_data;
+ 	struct qca8k_mib_eth_data mib_eth_data;
++	bool can_access_phys_over_mgmt;
+ 	struct qca8k_mdio_cache mdio_cache;
+ 	struct qca8k_pcs pcs_port_0;
+ 	struct qca8k_pcs pcs_port_6;
+-- 
+2.45.3
+
-- 
2.48.1

