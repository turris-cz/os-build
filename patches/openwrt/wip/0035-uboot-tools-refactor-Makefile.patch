From 01c12c2be6d0cf6cc8690331ccb2392688b1a7d4 Mon Sep 17 00:00:00 2001
From: Tomas Zak <tomas.zak@turris.com>
Date: Thu, 2 Jan 2025 18:27:37 +0100
Subject: [PATCH] uboot-tools: refactor Makefile and add dependency

Added dependency on python3 and refactor Makefile change spaces to tabs
---
 package/boot/uboot-tools/Makefile | 100 ++++++++++++++++--------------
 1 file changed, 24 insertions(+), 18 deletions(-)

diff --git a/package/boot/uboot-tools/Makefile b/package/boot/uboot-tools/Makefile
index 24e6e3b9e6..c538b25c0a 100644
--- a/package/boot/uboot-tools/Makefile
+++ b/package/boot/uboot-tools/Makefile
@@ -21,7 +21,7 @@ PKG_HASH:=f591da9ab90ef3d6b3d173766d0ddff90c4ed7330680897486117df390d83c8f
 PKG_SOURCE_SUBDIR:=$(PKG_DISTNAME)-$(PKG_VERSION)
 PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_DISTNAME)-$(PKG_VERSION)
 
-PKG_BUILD_DEPENDS:=fstools
+PKG_BUILD_DEPENDS:=fstools python3/host
 
 PKG_LICENSE:=GPL-2.0 GPL-2.0+
 PKG_LICENSE_FILES:=Licenses/README
@@ -61,6 +61,12 @@ TARGET_CFLAGS += -I$(STAGING_DIR)/usr/include
 
 define Build/Configure
 	$(call Build/Compile/Default,tools-only_defconfig)
+	touch $(PKG_BUILD_DIR)/include/config.h
+	mkdir -p $(PKG_BUILD_DIR)/include/config
+	touch $(PKG_BUILD_DIR)/include/config/auto.conf
+	mkdir -p $(PKG_BUILD_DIR)/include/generated
+	touch $(PKG_BUILD_DIR)/include/generated/autoconf.h
+	touch $(PKG_BUILD_DIR)
 endef
 
 define Build/Compile
@@ -102,29 +108,29 @@ define Package/uboot-envtools/conffiles
 endef
 
 define Package/uboot-envtools/install
-	$(INSTALL_DIR) $(1)/usr/sbin
-	$(INSTALL_BIN) $(PKG_BUILD_DIR)/fw_printenv $(1)/usr/sbin/fw_printenv
-	$(LN) fw_printenv $(1)/usr/sbin/fw_setenv
-	$(INSTALL_BIN) ./files/fw_printsys $(1)/usr/sbin
-	$(INSTALL_BIN) ./files/fw_setsys $(1)/usr/sbin
-	$(INSTALL_BIN) ./files/fw_loadenv $(1)/usr/sbin
-	$(INSTALL_DIR) $(1)/etc/board.d
-	$(INSTALL_DATA) ./files/fw_defaults $(1)/etc/board.d/05_fw_defaults
-	$(INSTALL_DIR) $(1)/lib
-	$(INSTALL_DATA) ./files/uboot-envtools.sh $(1)/lib
-	$(INSTALL_DIR) $(1)/usr/bin
-	$(INSTALL_DIR) $(1)/etc/uci-defaults
-	$(if $(wildcard ./files/$(BOARD)_$(SUBTARGET)), \
-		$(INSTALL_BIN) ./files/$(BOARD)_$(SUBTARGET) \
-		$(1)/usr/bin/fw_env-config-init.sh && \
-		printf '#!/bin/sh\nexec /usr/bin/fw_env-config-init.sh' \
-		>$(1)/etc/uci-defaults/30_uboot-envtools, \
-		$(if $(wildcard ./files/$(BOARD)), \
-			$(INSTALL_BIN) ./files/$(BOARD) $(1)/usr/bin/fw_env-config-init.sh && \
-			printf '#!/bin/sh\nexec /usr/bin/fw_env-config-init.sh' \
-			        >$(1)/etc/uci-defaults/30_uboot-envtools \
-		) \
-	)
+		$(INSTALL_DIR) $(1)/usr/sbin
+		$(INSTALL_BIN) $(PKG_BUILD_DIR)/fw_printenv $(1)/usr/sbin/fw_printenv
+		$(LN) fw_printenv $(1)/usr/sbin/fw_setenv
+		$(INSTALL_BIN) ./files/fw_printsys $(1)/usr/sbin
+		$(INSTALL_BIN) ./files/fw_setsys $(1)/usr/sbin
+		$(INSTALL_BIN) ./files/fw_loadenv $(1)/usr/sbin
+		$(INSTALL_DIR) $(1)/etc/board.d
+		$(INSTALL_DATA) ./files/fw_defaults $(1)/etc/board.d/05_fw_defaults
+		$(INSTALL_DIR) $(1)/lib
+		$(INSTALL_DATA) ./files/uboot-envtools.sh $(1)/lib
+	$(INSTALL_DIR) $(1)/usr/bin
+		$(INSTALL_DIR) $(1)/etc/uci-defaults
+		$(if $(wildcard ./files/$(BOARD)_$(SUBTARGET)), \
+		$(INSTALL_BIN) ./files/$(BOARD)_$(SUBTARGET) \
+		$(1)/usr/bin/fw_env-config-init.sh && \
+		printf '#!/bin/sh\nexec /usr/bin/fw_env-config-init.sh' \
+		>$(1)/etc/uci-defaults/30_uboot-envtools, \
+			$(if $(wildcard ./files/$(BOARD)), \
+				$(INSTALL_BIN) ./files/$(BOARD) $(1)/usr/bin/fw_env-config-init.sh && \
+				printf '#!/bin/sh\nexec /usr/bin/fw_env-config-init.sh' \
+				>$(1)/etc/uci-defaults/30_uboot-envtools \
+			) \
+		)
 endef
 
 define Package/uboot-mkimage/install
-- 
2.47.1

