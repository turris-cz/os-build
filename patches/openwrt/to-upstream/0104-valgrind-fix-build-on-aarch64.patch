From 58919240186fc64aa7413ff9dcc1e6ff504d2a23 Mon Sep 17 00:00:00 2001
From: Tomas Zak <tomas.zak@nic.cz>
Date: Tue, 11 Mar 2025 19:37:16 +0100
Subject: [PATCH] valgrind: fix build on aarch64

Based on this commit ffa4be4c14a76f0020929fadbcd7056f0d80f837 from
openwrt

Signed-off-by: Tomas Macholda <tomas.macholda@nic.cz>
---
 package/devel/valgrind/Makefile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/package/devel/valgrind/Makefile b/package/devel/valgrind/Makefile
index 6027495c8b..3858b46e31 100644
--- a/package/devel/valgrind/Makefile
+++ b/package/devel/valgrind/Makefile
@@ -100,6 +100,8 @@ endif
 ifeq ($(ARCH),arm)
   ifeq ($(CONFIG_arm_v7),y)
 	CONFIGURE_ARGS += --host=armv7-openwrt-linux$(if $(TARGET_SUFFIX),-$(TARGET_SUFFIX))
+  else ifeq ($(CONFIG_aarch64),y)
+	CONFIGURE_ARGS += --host=aarch64-openwrt-linux$(if $(TARGET_SUFFIX),-$(TARGET_SUFFIX))
   endif
 endif
 
-- 
2.53.0

