From: =?UTF-8?q?Tom=C3=A1=C5=A1=20Macholda?= <tomas.macholda@nic.cz>
Date: Tue, 7 Apr 2026 12:22:29 +0200
Subject: [PATCH] base-files/leds: set trigger in ucidef_set_led_default
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Tomáš Macholda <tomas.macholda@nic.cz>
---
 package/base-files/files/lib/functions/uci-defaults.sh | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/package/base-files/files/lib/functions/uci-defaults.sh b/package/base-files/files/lib/functions/uci-defaults.sh
index f77ce4ab27..4757c1a6c5 100644
--- a/package/base-files/files/lib/functions/uci-defaults.sh
+++ b/package/base-files/files/lib/functions/uci-defaults.sh
@@ -434,6 +434,9 @@ ucidef_set_led_default() {
 	_ucidef_set_led_common "$1" "$2" "$3"
 
 	json_add_string default "$default"
+	[ "$default" = 1 ] && {
+		json_add_string trigger default-on
+	}
 	json_select ..
 
 	json_select ..
-- 
