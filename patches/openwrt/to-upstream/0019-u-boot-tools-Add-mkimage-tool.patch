diff --git a/package/boot/uboot-tools/Makefile b/package/boot/uboot-tools/Makefile
index 041bbe8f27..91f65f4bf8 100644
--- a/package/boot/uboot-tools/Makefile
+++ b/package/boot/uboot-tools/Makefile
@@ -29,6 +29,7 @@ define Package/dumpimage
 	CATEGORY:=Utilities
 	SUBMENU:=Boot Loaders
 	TITLE:=dumpimage lists and extracts data from U-Boot images.
+	DEPENDS:=+libopenssl
 endef
 
 define Package/dumpimage/description
@@ -43,6 +44,7 @@ define Package/fit-check-sign
 	CATEGORY:=Utilities
 	SUBMENU:=Boot Loaders
 	TITLE:=verify uImage.FIT
+	DEPENDS:=+libopenssl
 endef
 
 define Package/fit-check-sign/description
@@ -68,19 +70,27 @@ define Package/uboot-envtools/conffiles
 	/etc/fw_sys.config
 endef
 
+define Package/uboot-mkimage
+	SECTION:=utils
+	CATEGORY:=Utilities
+	SUBMENU:=Boot Loaders
+	TITLE:=create U-Boot bootloader images
+	URL:=http://www.denx.de/wiki/U-Boot
+	DEPENDS:=+libopenssl @OPENSSL_ENGINE
+endef
+
+define Package/uboot-mkimage/description
+ This package includes tools to create U-Boot bootloader images.
+endef
+
+TARGET_CFLAGS += -I$(STAGING_DIR)/usr/include
+
 define Build/Configure
 	$(call Build/Compile/Default,tools-only_defconfig)
 	$(SED) 's/CONFIG_TOOLS_LIBCRYPTO=y/# CONFIG_TOOLS_LIBCRYPTO is not set/' $(PKG_BUILD_DIR)/.config
 	$(SED) 's/CONFIG_TOOLS_KWBIMAGE=y/# CONFIG_TOOLS_KWBIMAGE is not set/' $(PKG_BUILD_DIR)/.config
 endef
 
-MAKE_FLAGS += \
-	ARCH="sandbox" \
-	TARGET_CFLAGS="$(TARGET_CFLAGS)" \
-	TARGET_LDFLAGS="$(TARGET_LDFLAGS)" \
-	NO_PYTHON=1 \
-	V=$(if $(findstring c,$(OPENWRT_VERBOSE)),1,)
-
 define Build/Compile
 
 ifneq ($(CONFIG_PACKAGE_uboot-envtools),)
@@ -92,6 +102,28 @@ endif
 
 endef
 
+define Build/Compile
+	$(MAKE) -C $(PKG_BUILD_DIR) \
+		CROSS_COMPILE="$(TARGET_CROSS)" \
+		TARGET_CFLAGS="$(TARGET_CFLAGS)" \
+		HOSTLDFLAGS= \
+		no-dot-config-targets=envtools \
+		CROSS_BUILD_TOOLS=1 \
+		NO_SDL=1 \
+		envtools tools-only_defconfig
+	mv $(PKG_BUILD_DIR)/tools/env/fw_printenv $(PKG_BUILD_DIR)
+	echo 'CONFIG_FIT=y' >> $(PKG_BUILD_DIR)/.config
+	echo 'CONFIG_MULTI_DTB_FIT=n' >> $(PKG_BUILD_DIR)/.config
+	sed -i 's|^CONFIG_TOOLS_MKEFICAPSULE=y|CONFIG_TOOLS_MKEFICAPSULE=n|' $(PKG_BUILD_DIR)/.config
+	$(MAKE) -C $(PKG_BUILD_DIR) \
+		CROSS_COMPILE="$(TARGET_CROSS)" \
+		TARGET_CFLAGS="$(TARGET_CFLAGS)" \
+		HOSTLDFLAGS= \
+		CROSS_BUILD_TOOLS=1 \
+		NO_SDL=1 \
+		cross_tools
+endef
+
 define Package/dumpimage/install
 	$(INSTALL_DIR) $(1)/usr/bin
 	$(INSTALL_BIN) $(PKG_BUILD_DIR)/tools/dumpimage $(1)/usr/bin
@@ -104,7 +136,7 @@ endef
 
 define Package/uboot-envtools/install
 	$(INSTALL_DIR) $(1)/usr/sbin
-	$(INSTALL_BIN) $(PKG_BUILD_DIR)/tools/env/fw_printenv $(1)/usr/sbin
+	$(INSTALL_BIN) $(PKG_BUILD_DIR)/fw_printenv $(1)/usr/sbin/fw_printenv
 	$(LN) fw_printenv $(1)/usr/sbin/fw_setenv
 	$(INSTALL_BIN) ./uboot-envtools/files/fw_printsys $(1)/usr/sbin
 	$(INSTALL_BIN) ./uboot-envtools/files/fw_setsys $(1)/usr/sbin
@@ -128,6 +160,12 @@ define Package/uboot-envtools/install
 	)
 endef
 
+define Package/uboot-mkimage/install
+	$(INSTALL_DIR) $(1)/usr/sbin
+	$(INSTALL_BIN) $(PKG_BUILD_DIR)/tools/mkimage $(1)/usr/sbin
+endef
+
 $(eval $(call BuildPackage,dumpimage))
 $(eval $(call BuildPackage,fit-check-sign))
 $(eval $(call BuildPackage,uboot-envtools))
+$(eval $(call BuildPackage,uboot-mkimage))
