. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)
boardname="${board##*,}"

case "$board" in
cznic,ipq9574-turris-omnia-ng)
	ucidef_set_led_default "power" "Power" "rgb:power" 1
	ucidef_add_led_color "power" "green" 255
	ucidef_set_led_netdev "wan" "WAN" "rgb:wan" "eth0"
	ucidef_set_led_netdev "wlan" "WLAN" "rgb:wlan" "br-lan"
	;;
esac

board_config_flush

exit 0
