Date: Tue, 20 May 2025 15:58:24 +0200
Subject: [PATCH] WIP: leds: Add WS2812B LED strip driver for Turris Omnia NG
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Marek Behún <kabel@kernel.org>
---
 drivers/leds/Kconfig            |   9 ++
 drivers/leds/Makefile           |   1 +
 drivers/leds/leds-ws2812b-spi.c | 208 ++++++++++++++++++++++++++++++++
 3 files changed, 218 insertions(+)
 create mode 100644 drivers/leds/leds-ws2812b-spi.c

diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index 3132439f9..f18d81b8e 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -193,6 +193,15 @@ config LEDS_TURRIS_OMNIA
 	  side of CZ.NIC's Turris Omnia router. There are 12 RGB LEDs on the
 	  front panel.
 
+config LEDS_WS2812B_SPI
+	tristate "LED support for CZ.NIC's Turris NG BOARD"
+	depends on LEDS_CLASS_MULTICOLOR
+	depends on SPI
+	depends on OF
+	help
+	  This option enables basic support for the LEDs found on the front
+	  side of CZ.NIC's Turris Omnia NG router. There is a led strip.
+
 config LEDS_LM3530
 	tristate "LCD Backlight driver for LM3530"
 	depends on LEDS_CLASS
diff --git a/drivers/leds/Makefile b/drivers/leds/Makefile
index d7348e8bc..b4f3c6a8d 100644
--- a/drivers/leds/Makefile
+++ b/drivers/leds/Makefile
@@ -88,6 +88,7 @@ obj-$(CONFIG_LEDS_TURRIS_OMNIA)		+= leds-turris-omnia.o
 obj-$(CONFIG_LEDS_WM831X_STATUS)	+= leds-wm831x-status.o
 obj-$(CONFIG_LEDS_WM8350)		+= leds-wm8350.o
 obj-$(CONFIG_LEDS_WRAP)			+= leds-wrap.o
+obj-$(CONFIG_LEDS_WS2812B_SPI)		+= leds-ws2812b-spi.o
 
 # LED SPI Drivers
 obj-$(CONFIG_LEDS_CR0014114)		+= leds-cr0014114.o
diff --git a/drivers/leds/leds-ws2812b-spi.c b/drivers/leds/leds-ws2812b-spi.c
new file mode 100644
index 000000000..b3dae8ce9
--- /dev/null
+++ b/drivers/leds/leds-ws2812b-spi.c
@@ -0,0 +1,208 @@
+#include <linux/spi/spi.h>
+#include <linux/minmax.h>
+#include <linux/led-class-multicolor.h>
+
+#define WS2812B_DESIRED_FREQ	6400000
+
+#define WS2812B_ZERO_BIT	0b11100000
+#define WS2812B_ONE_BIT		0b11111000
+
+#define WS2182B_BYTES_PER_CHAN	8
+#define WS2182B_BYTES_PER_LED	(WS2182B_BYTES_PER_CHAN * 3)
+#define WS2812B_STOP_SIZE	150
+
+struct ws2812b_led {
+	struct ws2812b *priv;
+	struct led_classdev_mc mc_lcdev;
+	struct mc_subled subled_info[3];
+};
+
+struct ws2812b {
+	struct device *dev;
+	struct spi_device *spi;
+	struct mutex lock;
+	u8 *buf;
+	size_t buf_size;
+	size_t led_count;
+	struct ws2812b_led leds[];
+};
+
+static void ws2812b_buf_fill_channel(u8 *buf, u8 channel, u8 value)
+{
+	buf += WS2182B_BYTES_PER_CHAN * channel;
+
+	for (int bit = 7; bit >= 0; --bit)
+		*buf++ = (value & BIT(bit)) ? WS2812B_ONE_BIT : WS2812B_ZERO_BIT;
+}
+
+static void ws2812b_buf_fill_color(struct ws2812b *priv, unsigned int led)
+{
+	const struct mc_subled *subled = priv->leds[led].subled_info;
+	u8 *buf = priv->buf + WS2182B_BYTES_PER_LED * led;
+
+	ws2812b_buf_fill_channel(buf, 0, subled[1].brightness);
+	ws2812b_buf_fill_channel(buf, 1, subled[0].brightness);
+	ws2812b_buf_fill_channel(buf, 2, subled[2].brightness);
+}
+
+/*
+static void ws2812b_make_buf(struct ws2812b *priv)
+{
+	u8 *buf = priv->buf;
+	for (size_t i = 0; i < priv->led_count; ++i) {
+		for (int c = 0; c < priv->leds[i].mc_lcdev.num_colors; ++c) {
+			size_t index = WS2182B_BYTES_PER_LED * i + 8 * c;
+			unsigned int brightness =
+					priv->leds[i].mc_lcdev.subled_info[c].brightness;
+			for (int b = 0; b < 8; ++b) {
+				buf[index+b] = (brightness & (1 << (7-b))) ? ONE_BIT : ZERO_BIT;
+			}
+		}
+	}
+	for (int i = priv->led_count * WS2182B_BYTES_PER_LED; i < priv->buf_size; ++i)
+		buf[i] = 0;
+}
+
+static int ws2812b_write(struct ws2812b *priv)
+{
+	int ret;
+	ws2812b_make_buf(priv);
+	ret = spi_write(priv->spi, priv->buf, priv->buf_size);
+	if (ret) {
+		dev_err(priv->dev, "spi_write() error %d", ret);
+		return ret;
+	}
+	return 0;
+}
+*/
+
+static int
+ws2812b_brightness_set_blocking(struct led_classdev *cdev, enum led_brightness brightness)
+{
+	struct led_classdev_mc *mc_cdev = lcdev_to_mccdev(cdev);
+	struct ws2812b_led *led = container_of(mc_cdev, struct ws2812b_led, mc_lcdev);
+	struct ws2812b *priv = dev_get_drvdata(cdev->dev->parent);
+	unsigned int idx = led - priv->leds;
+	int err;
+
+	mutex_lock(&led->priv->lock);
+
+	led_mc_calc_color_components(mc_cdev, brightness);
+	ws2812b_buf_fill_color(priv, idx);
+	err = spi_write(priv->spi, priv->buf, priv->buf_size);
+
+	mutex_unlock(&led->priv->lock);
+
+	return err;
+}
+
+static int ws2812b_probe_dt(struct ws2812b *priv)
+{
+	struct led_init_data init_data = {};
+	struct fwnode_handle *child;
+	size_t i = 0;
+	int ret;
+
+	device_for_each_child_node(priv->dev, child) {
+		struct ws2812b_led *led;
+		led = &priv->leds[i];
+
+		led->priv = priv;
+
+		led->subled_info[0].color_index = LED_COLOR_ID_RED;
+		led->subled_info[0].channel = 0;
+		led->subled_info[1].color_index = LED_COLOR_ID_GREEN;
+		led->subled_info[1].channel = 1;
+		led->subled_info[2].color_index = LED_COLOR_ID_BLUE;
+		led->subled_info[2].channel = 2;
+
+		led->mc_lcdev.subled_info = led->subled_info;
+		led->mc_lcdev.num_colors = 3;
+
+		init_data.fwnode = child;
+
+		led->mc_lcdev.led_cdev.max_brightness = 255;
+		led->mc_lcdev.led_cdev.brightness_set_blocking =
+			ws2812b_brightness_set_blocking;
+
+		ws2812b_buf_fill_color(priv, i);
+
+		ret = devm_led_classdev_multicolor_register_ext(
+			priv->dev, &led->mc_lcdev, &init_data);
+		if (ret) {
+			dev_err(priv->dev,
+				"failed to register LED device, err %d", ret);
+			fwnode_handle_put(child);
+			return ret;
+		}
+		++i;
+	}
+
+	return 0;
+}
+
+static int ws2812b_probe(struct spi_device *spi)
+{
+	struct ws2812b *priv;
+	size_t count;
+
+	count = device_get_child_node_count(&spi->dev);
+	if (!count) {
+		dev_err(&spi->dev, "Leds are not defined in device tree!");
+		return -ENODEV;
+	}
+
+	if (spi->max_speed_hz != WS2812B_DESIRED_FREQ) {
+		dev_err(&spi->dev,
+			"Please set speed to %u Hz, other speeds are unsupported!",
+			WS2812B_DESIRED_FREQ);
+		return -EPROTO;
+	}
+
+	priv = devm_kzalloc(&spi->dev, struct_size(priv, leds, count),
+			    GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->buf_size = WS2182B_BYTES_PER_LED * count + WS2812B_STOP_SIZE;
+	priv->buf = devm_kzalloc(&spi->dev, priv->buf_size, GFP_KERNEL);
+	if (!priv->buf)
+		return -ENOMEM;
+	priv->spi = spi;
+	priv->led_count = count;
+	priv->dev = &spi->dev;
+	mutex_init(&priv->lock);
+
+	spi_set_drvdata(spi, priv);
+
+	return ws2812b_probe_dt(priv);
+}
+
+static void ws2812b_remove(struct spi_device *spi)
+{
+	struct ws2812b *priv = spi_get_drvdata(spi);
+
+	mutex_destroy(&priv->lock);
+}
+
+static const struct of_device_id ws2812b_spi_dts_ids[] = {
+	{ .compatible = "worldsemi,ws2812b-spi", },
+	{},
+};
+
+MODULE_DEVICE_TABLE(of, omnia_id);
+
+static struct spi_driver ws2812b_spi_driver = {
+	.probe = ws2812b_probe,
+	.remove = ws2812b_remove,
+	.driver = {
+		   .name = KBUILD_MODNAME,
+		   .of_match_table = ws2812b_spi_dts_ids,
+	},
+};
+
+module_spi_driver(ws2812b_spi_driver);
+
+MODULE_AUTHOR("Marek Behun <kabel@kernel.org>");
+MODULE_DESCRIPTION("ws2812b spi driver");
+MODULE_LICENSE("GPL v2");
-- 
