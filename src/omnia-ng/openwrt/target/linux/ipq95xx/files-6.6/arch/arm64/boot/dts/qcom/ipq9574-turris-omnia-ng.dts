/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "ipq9574.dtsi"
#include "ipq9574-qcn9224-default-memory.dtsi"

#define BROKEN_RPM 0
#define BROKEN_QCA8085 0
#define BROKEN_SFP 0
#define __MHI_BUS_RESERVED_DMA_POOL__

/ {
	model = "CZ.NIC Turris Omnia NG";
	compatible = "cznic,ipq9574-turris-omnia-ng", "qcom,ipq9574";

	aliases {
		serial0 = &blsp1_uart2;
		serial1 = &blsp1_uart4;
		serial2 = &blsp1_uart3;
#if !BROKEN_QCA8085
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
#endif
#if !BROKEN_SFP
		ethernet4 = "/soc/dp5";
		ethernet5 = "/soc/dp6";
#endif
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vsdhc: vsdhc-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vsdhc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tlmm 18 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vsdio: vsdc-regulator {
		compatible = "regulator-gpio";
		regulator-name = "vsdio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;

		gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
		gpios-states = <0>;
		states = <1800000 0x1>, <3300000 0x0>;
		enable-active-high;
	};

	vcc_sfp: regulator-3v3-sfp {
		compatible = "regulator-fixed";
		regulator-name = "3V3-sfp-supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&i2c_gpio2 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <50000>;
	};

	vcc_m2_e: regulator-3v3-m2-e {
		compatible = "regulator-fixed";
		regulator-name = "3V3-m2-e-supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&i2c_gpio2 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		startup-delay-us = <50000>;
	};

		m2_b_nWDIS: fake-regulator-m2-b-nWDIS {
		        compatible = "regulator-fixed";
		        regulator-name = "fake-regulator-m2-b-nWDIS";
		        regulator-min-microvolt = <1800000>;
		        regulator-max-microvolt = <1800000>;
		        gpios = <&i2c_gpio1 4 GPIO_ACTIVE_HIGH>;
		        enable-active-high;
		        regulator-always-on;
		        startup-delay-us = <50000>;
		};

		m2_b_nCRD_OFF: fake-regulator-m2-b-nCRD-OFF {
		        compatible = "regulator-fixed";
		        regulator-name = "fake-regulator-m2-b-nCRD-OFF";
		        regulator-min-microvolt = <1800000>;
		        regulator-max-microvolt = <1800000>;
		        gpios = <&i2c_gpio1 5 GPIO_ACTIVE_HIGH>;
		        enable-active-high;
		        regulator-always-on;
		        startup-delay-us = <50000>;

		        /* hack for M2-B config pins */
		        vin-supply = <&m2_b_nWDIS>;
		};

	vcc_m2_b: regulator-3v3-m2-b {
		compatible = "regulator-fixed";
		regulator-name = "3V3-m2-b-supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&i2c_gpio2 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		startup-delay-us = <50000>;

		/* hack for M2-B config pins */
		vin-supply = <&m2_b_nCRD_OFF>;
	};

	vcc_m2_m: regulator-3v3-m2-m {
		compatible = "regulator-fixed";
		regulator-name = "3V3-m2-m-supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&i2c_gpio2 3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		startup-delay-us = <50000>;
	};

#if !BROKEN_SFP
	sfp0: sfp0 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp0>;
		tx-fault-gpios = <&i2c_sfp0_gpio 0 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&i2c_sfp0_gpio 1 GPIO_ACTIVE_HIGH>;
		rate-select0-gpios = <&i2c_sfp0_gpio 3 GPIO_ACTIVE_HIGH>;
		rate-select1-gpios = <&i2c_sfp0_gpio 5 GPIO_ACTIVE_HIGH>;
		los-gpios = <&i2c_sfp0_gpio 4 GPIO_ACTIVE_HIGH>;
		mod-def0-gpios = <&i2c_sfp0_gpio 2 GPIO_ACTIVE_LOW>;
		maximum-power-milliwatt = <3000>;
		status = "okay";
	};

	sfp1: sfp1 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp1>;
		tx-fault-gpios = <&i2c_sfp1_gpio 0 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&i2c_sfp1_gpio 1 GPIO_ACTIVE_HIGH>;
		rate-select0-gpios = <&i2c_sfp1_gpio 3 GPIO_ACTIVE_HIGH>;
		rate-select1-gpios = <&i2c_sfp1_gpio 5 GPIO_ACTIVE_HIGH>;
		los-gpios = <&i2c_sfp1_gpio 4 GPIO_ACTIVE_HIGH>;
		mod-def0-gpios = <&i2c_sfp1_gpio 2 GPIO_ACTIVE_LOW>;
		maximum-power-milliwatt = <3000>;
		status = "okay";
	};
#endif

	soc@0 {
		mdio@90000 {
			pinctrl-0 = <&mdio_pins>;
			pinctrl-names = "default";
#if !BROKEN_QCA8085
			/* gpio60 for manhattan reset */
			phy-reset-gpio = <&tlmm 60 GPIO_ACTIVE_LOW>;
			phyaddr_fixup = <0xC90F018>;
			uniphyaddr_fixup = <0xC90F014>;
			mdio_clk_fixup; /* MDIO clock sequence fix up flag */
#endif
			status = "okay";

#if !BROKEN_QCA8085
			phy0: ethernet-phy@0 {
				reg = <1>;
				fixup;
			};
			phy1: ethernet-phy@1 {
				reg = <2>;
				fixup;
			};
			phy2: ethernet-phy@2 {
				reg = <3>;
				fixup;
			};
			phy3: ethernet-phy@3 {
				reg = <4>;
				fixup;
			};
#endif
#if !BROKEN_SFP
			phy4: ethernet-phy@4 {
				compatible ="ethernet-phy-ieee802.3-c45";
				reg = <0>;
			};
			phy5: ethernet-phy@5 {
				compatible ="ethernet-phy-ieee802.3-c45";
				reg = <8>;
			};
#endif
		};

		ess-instance {
			num_devices = <0x1>;
			ess-switch@3a000000 {
				switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
#if !BROKEN_SFP && !BROKEN_QCA8085
				switch_lan_bmp = <0x3e>; /* lan port bitmap */
				switch_wan_bmp = <0x40>; /* wan port bitmap */
#elif !BROKEN_QCA8085
				switch_lan_bmp = <0x1c>; /* lan port bitmap */
				switch_wan_bmp = <0x02>; /* wan port bitmap */
#else
				switch_lan_bmp = <0x20>; /* lan port bitmap */
				switch_wan_bmp = <0x40>; /* wan port bitmap */
#endif
				switch_mac_mode = <0x15>; /* mac mode for uniphy instance0*/
				switch_mac_mode1 = <0xe>; /* mac mode for uniphy instance1*/
				switch_mac_mode2 = <0xe>; /* mac mode for uniphy instance2*/

				qcom,port_phyinfo {
#if !BROKEN_QCA8085
					port@0 {
						port_id = <1>;
						phy_address = <1>;
					};
					port@1 {
						port_id = <2>;
						phy_address = <2>;
					};
					port@2 {
						port_id = <3>;
						phy_address = <3>;
					};
					port@3 {
						port_id = <4>;
						phy_address = <4>;
					};
#endif
#if !BROKEN_SFP
					port@4 {
						port_id = <5>;
						media-type = "sfp";
						phy_address = <30>;
						sfp = <&sfp0>;
					};
					port@5 {
						port_id = <6>;
						media-type = "sfp";
						phy_address = <31>;
						sfp = <&sfp1>;
					};
#endif
				};

#if !BROKEN_QCA8085
				led_source@0 {
					source = <0>;
					mode = "normal";
					speed = "all";
					blink_en = "enable";
					active = "high";
				};
				led_source@1 {
					source = <1>;
					mode = "normal";
					speed = "1000M";
					blink_en = "disable";
					active = "high";
				};
				led_source@3 {
					source = <3>;
					mode = "normal";
					speed = "all";
					blink_en = "enable";
					active = "high";
				};
				led_source@4 {
					source = <4>;
					mode = "normal";
					speed = "1000M";
					blink_en = "disable";
					active = "high";
				};
				led_source@6 {
					source = <6>;
					mode = "normal";
					speed = "all";
					blink_en = "enable";
					active = "high";
				};
				led_source@7 {
					source = <7>;
					mode = "normal";
					speed = "1000M";
					blink_en = "disable";
					active = "high";
				};
				led_source@9 {
					source = <9>;
					mode = "normal";
					speed = "all";
					blink_en = "enable";
					active = "high";
				};
				led_source@a {
					source = <0xa>;
					mode = "normal";
					speed = "1000M";
					blink_en = "disable";
					active = "high";
				};
#endif
			};
		};

		leds {
			compatible = "pwm-leds";
			status = "okay";

			led-1 {
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_INDICATOR;
				pwms = <&pwm 1 655361>;
				linux,default-trigger = "heartbeat";
				max-brightness = <8191>;
				default-state = "off";
			};
		};

		gpio-key-lights-toggle {
			compatible = "openwrt,gpio-button-hotplug", "gpio-keys";
			pinctrl-0 = <&force_usb_button_pins>;
			pinctrl-names = "default";
			status = "okay";
			button {
				label = "Force USB Boot";
				/* 
				 * Default behaviour in vendor OS is to control
				 * LED dimming, so use OpenWrt lights_toggle code
				 * https://openwrt.org/docs/guide-user/hardware/hardware.button
				 */
				linux,code = <0x021e>;
				gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
			};
		};

		gpio-keys {
			compatible = "gpio-keys";
			pinctrl-0 = <&dpad_pins>;
			pinctrl-names = "default";
			status = "okay";

			button-up {
				linux,code = <KEY_UP>;
				gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
			};

			button-down {
				linux,code = <KEY_DOWN>;
				gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
			};

			button-left {
				linux,code = <KEY_LEFT>;
				gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
			};

			button-right {
				linux,code = <KEY_RIGHT>;
				gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
			};

			button-mid {
				linux,code = <KEY_ENTER>;
				gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
			};
		};

		backlight: backlight {
			compatible = "gpio-backlight";
			pinctrl-0 = <&backlight_pins>;
			pinctrl-names = "default";
			gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		};

#if !BROKEN_QCA8085
		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <1>;
			reg = <0x3a500000 0x4000>;
			qcom,mactype = <1>;
			qcom,link-poll = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <1>;
			phy-mode = "qusgmii";
			qcom,ppe-offload-disabled = <1>;
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <2>;
			reg = <0x3a504000 0x4000>;
			qcom,mactype = <1>;
			qcom,link-poll = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <2>;
			phy-mode = "qusgmii";
			qcom,ppe-offload-disabled = <1>;
		};

		dp3 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <3>;
			reg = <0x3a508000 0x4000>;
			qcom,mactype = <1>;
			qcom,link-poll = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <3>;
			phy-mode = "qusgmii";
			qcom,ppe-offload-disabled = <1>;
		};

		dp4 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <4>;
			reg = <0x3a50c000 0x4000>;
			qcom,mactype = <1>;
			qcom,link-poll = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <4>;
			phy-mode = "qusgmii";
			qcom,ppe-offload-disabled = <1>;
		};
#endif
#if !BROKEN_SFP
		dp5 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <5>;
			reg = <0x3a510000 0x4000>;
			qcom,mactype = <1>;
			qcom,link-poll = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <30>;
			phy-mode = "usxgmii";
		};

		dp6 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <6>;
			reg = <0x3a514000 0x4000>;
			qcom,mactype = <1>;
			qcom,link-poll = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <31>;
			phy-mode = "usxgmii";
		};
#endif

		/* EDMA host driver configuration for the board */
		edma@3ab00000 {
			qcom,txdesc-ring-start = <4>;		/* Tx desc ring start ID */
			qcom,txdesc-rings = <28>;		/* Total number of Tx desc rings to be provisioned */
			qcom,txcmpl-ring-start = <4>;		/* Tx complete ring start ID */
			qcom,txcmpl-rings = <28>;		/* Total number of Tx complete rings to be provisioned */
			qcom,rxfill-ring-start = <4>;		/* Rx fill ring start ID */
			qcom,rxfill-rings = <4>;		/* Total number of Rx fill rings to be provisioned */
			qcom,rxdesc-ring-start = <20>;		/* Rx desc ring start ID */
			qcom,rxdesc-rings = <4>;		/* Total number of Rx desc rings to be provisioned */
			qcom,rx-page-mode = <0>;		/* Rx fill ring page mode */
			qcom,tx-map-priority-level = <1>;	/* Tx priority level per port */
			qcom,rx-map-priority-level = <1>;	/* Rx priority level per core */
			qcom,num_loopback_rings = <1>;
			qcom,txdesc_loopback_ring_id = <0>;
			qcom,txcmpl_loopback_ring_id = <0>;
			qcom,rxfill_loopback_ring_id = <0>;
			qcom,rxdesc_loopback_ring_id = <0>;
			qcom,loopback_queue_base = <56>;
			qcom,loopback_num_queues = <8>;
			qcom,ppeds-num = <3>;			/* Number of PPEDS nodes */
			/* PPE-DS node format: <Rx-fill Tx-cmpl Rx Tx Queue-base Queue-count> */
			qcom,ppeds-map = <1 1 1 1 32 8>,	/* PPEDS Node#0 ring and queue map */
					<2 2 2 2 40 8>,		/* PPEDS Node#1 ring and queue map */
					<3 3 3 3 48 8>;		/* PPEDS Node#2 ring and queue map */
			qcom,txdesc-map = <8 9 10 11>,		/* Port0 per-core Tx ring map */
					<12 13 14 15>,		/* Port1 per-core Tx ring map */
					<16 17 18 19>,		/* Port2 per-core Tx ring map */
					<20 21 22 23>,		/* Port3 per-core Tx ring map */
					<24 25 26 27>,		/* Port4 per-core Tx ring map */
					<28 29 30 31>,		/* Port5 per-core Tx ring map */
					<4 5 6 7>;		/* Used only for packets from VP */
			qcom,txdesc-fc-grp-map = <1 2 3 4 5 6>;	/* Per GMAC flow control group map */
			qcom,rxfill-map = <4 5 6 7>;		/* Per-core Rx fill ring map */
			qcom,rxdesc-map = <20 21 22 23>;	/* Per-core Rx desc ring map */
			qcom,rx-queue-start = <0>;		/* Rx queue start */
			qcom,rx-ring-queue-map = <0 8 16 24>,	/* Priority 0 queues per-core Rx ring map */
					<1 9 17 25>,		/* Priority 1 queues per-core Rx ring map */
					<2 10 18 26>,		/* Priority 2 queues per-core Rx ring map */
					<3 11 19 27>,		/* Priority 3 queues per-core Rx ring map */
					<4 12 20 28>,		/* Priority 4 queues per-core Rx ring map */
					<5 13 21 29>,		/* Priority 5 queues per-core Rx ring map */
					<6 14 22 30>,		/* Priority 6 queues per-core Rx ring map */
					<7 15 23 31>;		/* Priority 7 queues per-core Rx ring map */
			qcom,vp-id = <8>;			/* Virtual port dummy MAC Id */
			qcom,txdesc_point_offload_ring = <0>;		/* Txdesc point offlaod ring */
			qcom,txcmpl_point_offload_ring = <0>;		/* Txcmpl point offlaod ring */
			qcom,rxfill_point_offload_ring = <0>;		/* Rxfill point offlaod ring */
			qcom,rxdesc_point_offload_ring = <0>;		/* Rxdesc point offlaod ring */
			interrupts = <0 367 4>,			/* Tx complete ring id #4 IRQ info */
				   <0 368 4>,			/* Tx complete ring id #5 IRQ info */
				   <0 369 4>,			/* Tx complete ring id #6 IRQ info */
				   <0 370 4>,			/* Tx complete ring id #7 IRQ info */
				   <0 371 4>,			/* Tx complete ring id #8 IRQ info */
				   <0 372 4>,			/* Tx complete ring id #9 IRQ info */
				   <0 373 4>,			/* Tx complete ring id #10 IRQ info */
				   <0 374 4>,			/* Tx complete ring id #11 IRQ info */
				   <0 375 4>,			/* Tx complete ring id #12 IRQ info */
				   <0 376 4>,			/* Tx complete ring id #13 IRQ info */
				   <0 377 4>,			/* Tx complete ring id #14 IRQ info */
				   <0 378 4>,			/* Tx complete ring id #15 IRQ info */
				   <0 379 4>,			/* Tx complete ring id #16 IRQ info */
				   <0 380 4>,			/* Tx complete ring id #17 IRQ info */
				   <0 381 4>,			/* Tx complete ring id #18 IRQ info */
				   <0 382 4>,			/* Tx complete ring id #19 IRQ info */
				   <0 383 4>,			/* Tx complete ring id #20 IRQ info */
				   <0 384 4>,			/* Tx complete ring id #21 IRQ info */
				   <0 509 4>,			/* Tx complete ring id #22 IRQ info */
				   <0 508 4>,			/* Tx complete ring id #23 IRQ info */
				   <0 507 4>,			/* Tx complete ring id #24 IRQ info */
				   <0 506 4>,			/* Tx complete ring id #25 IRQ info */
				   <0 505 4>,			/* Tx complete ring id #26 IRQ info */
				   <0 504 4>,			/* Tx complete ring id #27 IRQ info */
				   <0 503 4>,			/* Tx complete ring id #28 IRQ info */
				   <0 502 4>,			/* Tx complete ring id #29 IRQ info */
				   <0 501 4>,			/* Tx complete ring id #30 IRQ info */
				   <0 500 4>,			/* Tx complete ring id #31 IRQ info */
				   <0 351 4>,			/* Rx desc ring id #20 IRQ info */
				   <0 352 4>,			/* Rx desc ring id #21 IRQ info */
				   <0 353 4>,			/* Rx desc ring id #22 IRQ info */
				   <0 354 4>,			/* Rx desc ring id #23 IRQ info */
				   <0 499 4>,			/* Misc error IRQ info */
				   <0 359 4>,			/* RxFill ring id #4 IRQ info */
				   <0 360 4>,			/* RxFill ring id #5 IRQ info */
				   <0 361 4>,			/* RxFill ring id #6 IRQ info */
				   <0 362 4>,			/* RxFill ring id #7 IRQ info */
				   <0 364 4>,			/* PPEDS Node #1(TxComp ring id #1) TxComplete IRQ info */
				   <0 332 4>,			/* PPEDS Node #1(Rx Desc ring id #1) Rx Desc IRQ info */
				   <0 356 4>,			/* PPEDS Node #1(RxFill Desc ring id #1) Rx Fill IRQ info */
				   <0 365 4>,			/* PPEDS Node #2(TxComp ring id #2) TxComplete IRQ info */
				   <0 333 4>,			/* PPEDS Node #2(Rx Desc ring id #2) Rx Desc IRQ info */
				   <0 357 4>,			/* PPEDS Node #2(RxFill Desc ring id #2) Rx Fill IRQ info */
				   <0 366 4>,			/* PPEDS Node #3(TxComp ring id #3) TxComplete IRQ info */
				   <0 334 4>,			/* PPEDS Node #3(Rx Desc ring id #3) Rx Desc IRQ info */
				   <0 358 4>;			/* PPEDS Node #3(RxFill Desc ring id #3) Rx Fill IRQ info */

		};

#if BROKEN_RPM
		/* dat prec ked bude fungovat MP5496 cez RPM */
		dummy_reg_cpu: dummy-regulator@1 {
			compatible = "regulator-fixed";
			regulator-name = "dummy-reg-cpu";
			regulator-min-microvolt = <1075000>;
			regulator-max-microvolt = <1075000>;
			regulator-always-on;
			regulator-boot-on;
		};
#endif
	};

#if BROKEN_RPM
	/* dat prec ked bude fungovat MP5496 cez RPM */
	rpm-glink {
		status = "disabled";
	};
#endif
};

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&blsp1_uart4 {
	pinctrl-0 = <&uart4_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&pcie0_phy {
	status = "okay";
};

&pcie0_x1 {
	pinctrl-0 = <&pci0_pin>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie0_rp: pcie0_rp {
		reg = <0 0 0 0 0>;
	};
};

/* Turris Omnia NG FIXME: is this needed? */
&wsi {
	id = <0>;
	num_chip = <1>;
	status = "okay";
	chip_info = <0 0>;
};

&pcie1_phy {
	status = "okay";
};

&pcie1_lane {
	/*
	 * Turris Omnia NG FIXME:
	 * This supply actually supplies the 3V3 power into the card in the M2-B
	 * connector, not the PCIe PHY. But there is no device-tree binding for
	 * the connector yet, and we need to make sure that the supply is
	 * enabled before the PCIe driver tries to establish a link with the
	 * card. Declaring the supply needed for the PHY does this without the
	 * need to change driver code.
	 */
	phy-supply = <&vcc_m2_b>;
};

&pcie1_x1 {
	pinctrl-0 = <&pci1_pin>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
	status = "okay";
	pcie1_rp: pcie1_rp {
		reg = <0 0 0 0 0>;
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie2_lanes {
	/*
	 * Turris Omnia NG FIXME:
	 * This supply actually supplies the 3V3 power into the card in the M2-E
	 * connector, not the PCIe PHY. But there is no device-tree binding for
	 * the connector yet, and we need to make sure that the supply is
	 * enabled before the PCIe driver tries to establish a link with the
	 * card. Declaring the supply needed for the PHY does this without the
	 * need to change driver code.
	 */ 
	phy-supply = <&vcc_m2_e>;
};

&pcie2_x2 {
	pinctrl-0 = <&pci2_pin>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";
	pcie2_rp: pcie2_rp {
		reg = <0 0 0 0 0>;

		wifi@2 {
			reg = <0 0 0 0 0>;
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0     /* MX Rail, GPIO52, Drive strength 0x3 */
					0x4 0x4 0x18 0x3 0x0 0x0  /* RFA1p2 Rail, GPIO24, Drive strength 0x3 */
					0x0 0x4 0x0 0x0 0x0 0x0>; /* End of arguments */
			memory-region = <&qcn9224_pcie2>, <&mhi_region2>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			qcom,early_cal_enabled = "supported";
			qcom,caldata_offset = <0x8A800>;
			qcom,board_id = <0x1006>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <0>;
			turris,try-hacky-board-id;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
				};
				port@1 {
					reg = <1>;
				};
			};
		};
	};
};

&pcie3_phy {
	status = "okay";
};

&pcie3_lanes {
	/*
	 * Turris Omnia NG FIXME:
	 * This supply actually supplies the 3V3 power into the card in the M2-M
	 * connector, not the PCIe PHY. But there is no device-tree binding for
	 * the connector yet, and we need to make sure that the supply is
	 * enabled before the PCIe driver tries to establish a link with the
	 * card. Declaring the supply needed for the PHY does this without the
	 * need to change driver code.
	 */
	phy-supply = <&vcc_m2_m>;
};

&pcie3_x2 {
	pinctrl-0 = <&pci3_pin>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "okay";
	pcie3_rp: pcie3_rp {
		reg = <0 0 0 0 0>;
	};
};

&qpic_bam {
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&blsp1_spi0 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "micron,n25q128a11", "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <50000000>;
	};
};

&blsp1_spi1 {
	pinctrl-0 = <&spi_1_lcd_pins>;
	pinctrl-names = "default";
	cs-gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>, <&tlmm 57 GPIO_ACTIVE_LOW>;
	num-cs = <2>;
	status = "okay";

	display@0 {
		compatible = "cznic,turris-omnia-ng-display", "panel-mipi-dbi-spi";
		reg = <0>;
		spi-max-frequency = <50000000>;
		dc-gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
		write-only;
		spi-cpha;
		spi-cpol;
		format = "r5g6b5";
		backlight = <&backlight>;
		width-mm = <28>;
		height-mm = <28>;
		rotation = <270>;

		panel-timing {
			hactive = <240>;
			vactive = <240>;
			hback-porch = <80>;
			vback-porch = <0>;
			clock-frequency = <0>;
			hfront-porch = <0>;
			hsync-len = <0>;
			vfront-porch = <0>;
			vsync-len = <0>;
		};
	};

	led-controller@1 {
		compatible = "worldsemi,ws2812b-spi";
		reg = <1>;
		num-leds = <4>;
		spi-max-frequency = <6400000>;
		write-only;
		spi-cpha;
		spi-cs-high;
		#address-cells = <1>;
		#size-cells = <0>;

		multi-led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_INDICATOR;
		};

		multi-led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_WLAN;
		};

		multi-led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_WAN;
		};

		multi-led@3 {
			reg = <3>;
			color = <LED_COLOR_ID_RGB>;
			function = LED_FUNCTION_POWER;
		};
	};
};

&sdhc_1 {
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	max-frequency = <384000000>;
	bus-width = <8>;
	vmmc-supply = <&vsdhc>;
	vqmmc-supply = <&vsdio>;
	cd-gpios = <&i2c_gpio1 7 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&blsp1_i2c3 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c_3_pins>;
	pinctrl-names = "default";
	status = "okay";
 
	i2c-mux@71 {
		compatible = "nxp,pca9848";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x71>;
 
		i2c_sfp0: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0>;
 
			i2c_sfp0_gpio: gpio-controller@20 {
				compatible = "nxp,pcal6408";
				reg = <0x20>;
				vcc-supply = <&vcc_sfp>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "SFP0_FLT", "SFP0_DIS", "SFP0_DET", "SFP0_RS0", "SFP0_LOS", "SFP0_RS1";
				interrupts-extended = <&i2c_gpio3 0 IRQ_TYPE_EDGE_FALLING>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};
 
		i2c_sfp1: i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x1>;
 
			i2c_sfp1_gpio: gpio-controller@20 {
				compatible = "nxp,pcal6408";
				reg = <0x20>;
				vcc-supply = <&vcc_sfp>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "SFP1_FLT", "SFP1_DIS", "SFP1_DET", "SFP1_RS0", "SFP1_LOS", "SFP1_RS1";
				interrupts-extended = <&i2c_gpio3 1 IRQ_TYPE_EDGE_FALLING>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};
 
		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x2>;
 
			i2c_gpio0: gpio-controller@20 {
				compatible = "nxp,pcal6408";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "M2M_CFG0", "M2M_CFG1", "M2M_CFG2", "M2M_CFG3", "M2E_nCARD_DET", "M2E_nWDIS1", "M2E_nWDIS2", "IO07";
				interrupts-extended = <&i2c_gpio3 3 IRQ_TYPE_EDGE_FALLING>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
 
			i2c_gpio1: gpio-controller@21 {
				compatible = "nxp,pcal6408";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "M2B_CFG0", "M2B_CFG1", "M2B_CFG2", "M2B_CFG3", "M2B_nWDIS", "M2B_nCRD_OFF", "M2B_RST", "SDC_DET";
				interrupts-extended = <&i2c_gpio3 4 IRQ_TYPE_EDGE_FALLING>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};
 
		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x3>;
 
			crypto@59 {
				compatible = "atmel,atecc608b";
				reg = <0x59>;
				status = "disabled";
			};
 
			rtc@51 {
				compatible = "nxp,pcf85063tp";
				reg = <0x51>;
				quartz-load-femtofarads = <12500>;
			};
		};

		i2c@4 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x4>;
 
			i2c_gpio2: gpio-controller@20 {
				compatible = "nxp,pcal6408";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "EN_PWR_SFP", "EN_PWR_M2-E", "EN_PWR_M2-B", "EN_PWR_M2-M", "PG_SFP", "PG_M2-E", "PG_M2-B", "PG_M2-M";
				interrupts-extended = <&i2c_gpio3 5 IRQ_TYPE_EDGE_FALLING>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			i2c_gpio3: gpio-controller@21 {
				compatible = "nxp,pcal6408";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "SFP0_nINT", "SFP1_nINT", "USBB_nINT", "GPIO0_nINT", "GPIO1_nINT", "GPIO2_nINT", "VBUS30_nOC", "IO37";
				interrupts-extended = <&tlmm 47 IRQ_TYPE_EDGE_FALLING>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&ssphy_0 {
	status = "okay";
};

#if !BROKEN_RPM
&rpm_requests {
	regulators {
		compatible = "qcom,rpm-mp5496-regulators";

		ipq9574_s1: s1 {
		/*
		 * During kernel bootup, the SoC runs at 800MHz with 875mV set by the bootloaders.
		 * During regulator registration, kernel not knowing the initial voltage,
		 * considers it as zero and brings up the regulators with minimum supported voltage.
		 * Updating the regulator-min-microvolt with SVS voltage of 725000uV so that
		 * the regulators are brought up with 725000uV which is sufficient for all the
		 * corner parts to operate at 800MHz
		 */
			regulator-min-microvolt = <587500>;
			regulator-max-microvolt = <1075000>;
		};
		ipq9574_s2: s2 {
			regulator-min-microvolt = <700000>;
			regulator-max-microvolt = <1000000>;
		};

		ipq9574_s4: s4 {
			regulator-min-microvolt = <1>;
			regulator-max-microvolt = <9>;
			regulator-always-on;
		};
	};
};

#endif

&tlmm {
	pci0_pin: pci0-default-state {
		pins = "gpio23";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pci1_pin: pci1-default-state {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
		output-low;
	};

	pci2_pin: pci2-default-state {
		pins = "gpio29";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
		output-low;
	};

	pci3_pin: pci3-default-state {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	i2c_3_pins: i2c-3-pins {
		pins = "gpio15", "gpio16";
		function = "blsp3_i2c";
		drive-strength = <8>;
		bias-disable;
	};

	dpad_pins: button-pins {
		pins = "gpio40", "gpio41", "gpio42", "gpio43", "gpio44";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	force_usb_button_pins: force-usb-button-pins {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	leds_pins: leds-pins {
		pins = "gpio55";
		function = "pwm";
		drive-strength = <8>;
		/*bias-pull-up;*/
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2",
			       "gpio3", "gpio6", "gpio7",
			       "gpio8", "gpio9";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		rclk-pins {
			pins = "gpio10";
			function = "sdc_rclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	spi_0_pins: spi-0-state {
		pins = "gpio11", "gpio12", "gpio13", "gpio14";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-disable;
	};

	backlight_pins: lcd-backlight-state {
		pins = "gpio46";
		function = "gpio";
		drive-strength = <0x08>;
		bias-disable;
	};

	uart4_pins: uart4-pins {
		pins = "gpio50", "gpio51", "gpio52", "gpio53";
		function = "blsp4_uart";
		drive-strength = <8>;
		bias-disable;
	};

	spi_1_lcd_pins: spi-1-lcd-state {
		spi-pins {
			pins = "gpio61", "gpio64";
			function = "blsp1_spi";
			drive-strength = <8>;
			bias-disable;
		};
 
		gpio-pins {
			pins = "gpio54", "gpio56", "gpio57", "gpio62", "gpio63";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
		};
	};
};

