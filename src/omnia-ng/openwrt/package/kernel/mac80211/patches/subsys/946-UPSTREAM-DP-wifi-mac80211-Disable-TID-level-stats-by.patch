 net/mac80211/tx.c             | 147 ++++++++++++++++++++++++----------
 net/mac80211/wep.c            |   5 +-
 net/mac80211/wpa.c            |   8 +-
 6 files changed, 208 insertions(+), 86 deletions(-)

