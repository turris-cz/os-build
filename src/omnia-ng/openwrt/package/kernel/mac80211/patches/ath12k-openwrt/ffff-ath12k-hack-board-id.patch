diff '--color=auto' -Naurp a/drivers/net/wireless/ath/ath12k/mhi.c b/drivers/net/wireless/ath/ath12k/mhi.c
--- a/drivers/net/wireless/ath/ath12k/mhi.c	2025-06-27 10:30:45.475840945 +0200
+++ b/drivers/net/wireless/ath/ath12k/mhi.c	2025-06-27 10:24:12.878068220 +0200
@@ -448,6 +448,21 @@ static int ath12k_mhi_read_addr_from_dt(
 	return 0;
 }
 
+static ushort ath12k_hacky_board_id;
+module_param_named(hacky_board_id, ath12k_hacky_board_id, ushort, 0644);
+
+unsigned int ath12k_turris_try_hacky_board_id(struct device *dev)
+{
+	if (!of_property_read_bool(dev->of_node, "turris,try-hacky-board-id"))
+		return 0;
+
+	if (ath12k_hacky_board_id == 0x2 || ath12k_hacky_board_id == 0x4 ||
+	    ath12k_hacky_board_id == 0xc || ath12k_hacky_board_id == 0x1006)
+		return ath12k_hacky_board_id;
+
+	return 0;
+}
+
 int ath12k_mhi_register(struct ath12k_pci *ab_pci)
 {
 	struct ath12k_base *ab = ab_pci->ab;
@@ -463,9 +478,12 @@ int ath12k_mhi_register(struct ath12k_pc
 
 	otp_board_id = ath12k_pci_read32(ab, QCN9224_QFPROM_RAW_RFA_PDET_ROW13_LSB);
 
-	board_id = FIELD_GET(OTP_BOARD_ID_MASK, otp_board_id);
-	if (!board_id || (board_id == OTP_INVALID_BOARD_ID)) {
-		if (of_property_read_u32(dev->of_node, "qcom,board_id", &board_id)) {
+	board_id = ath12k_turris_try_hacky_board_id(dev);
+	if (board_id) {
+		ath12k_info(ab, "forced board_id 0x%x by module parameter\n", board_id);
+	} else if (of_property_read_u32(dev->of_node, "qcom,board_id", &board_id) || !board_id || (board_id == OTP_INVALID_BOARD_ID)) {
+		board_id = FIELD_GET(OTP_BOARD_ID_MASK, otp_board_id);
+		if (!board_id || (board_id == OTP_INVALID_BOARD_ID)) {
 			ath12k_warn(ab, "failed to read board id\n");
 		}
 	}
