 #endif /* CPTCFG_ATH12K_DEBUGFS */
 	bool mcast_to_ucast_en;
 	u8 hw_link_id;
@@ -1647,6 +1752,7 @@ struct wsi_info {
 /* Master structure to hold the hw data which may be used in core module */
 struct ath12k_base {
 	bool stats_disable;
+	bool tid_stats_disable;
