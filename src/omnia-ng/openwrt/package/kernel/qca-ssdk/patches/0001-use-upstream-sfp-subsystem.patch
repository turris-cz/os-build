+static const phy_interface_t sfp_interface_preference[] = {
+	PHY_INTERFACE_MODE_USXGMII,
+	PHY_INTERFACE_MODE_10GBASER,
+	PHY_INTERFACE_MODE_2500BASEX,
+	PHY_INTERFACE_MODE_SGMII,
+	PHY_INTERFACE_MODE_1000BASEX,
+};
+
+static unsigned long mac_capabilities = MAC_SYM_PAUSE | MAC_10 | MAC_100 | MAC_1000FD | MAC_2500FD | MAC_10000FD;
+
+struct sfp_priv {
+	struct phy_device *upstream_phydev;
+
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(sfp_support);
+	DECLARE_PHY_INTERFACE_MASK(sfp_interfaces);
+	bool sfp_may_have_phy;
+	struct phylink_link_state link_config;
+	bool force_link_down_once;
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(supported);
+	struct phy_device *phydev;
+	bool module_present;
+
+	struct {
+		uint32_t dev, port;
+	} hw;
+};
+
+static struct sfp_priv *get_sfp_priv(struct phy_device *phydev)
+{
+	struct qca_phy_priv *priv = phydev->priv;
+	fal_port_t port = qca_ssdk_phydev_to_port(priv->device_id, phydev);
+	static struct sfp_priv privs[2];
+
+	if (port == 5)
+		return &privs[0];
+	else if (port == 6)
+		return &privs[1];
+	else
+		return NULL;
+}
+
+static const char *sfp_priv_netdev_name(struct sfp_priv *pl)
+{
+	if (pl->upstream_phydev->attached_dev)
+		return netdev_name(pl->upstream_phydev->attached_dev);
+	else if (pl->hw.port == 5)
+		return "sfp0";
+	else if (pl->hw.port == 6)
+		return "sfp1";
+	else
+		return "unknown";
+}
+
+static int sfp_iface_to_speed(phy_interface_t iface)
+{
+	switch (iface) {
+	case PHY_INTERFACE_MODE_USXGMII: return SPEED_10000;
+	case PHY_INTERFACE_MODE_10GBASER: return SPEED_10000;
+	case PHY_INTERFACE_MODE_2500BASEX: return SPEED_2500;
+	case PHY_INTERFACE_MODE_SGMII: return SPEED_1000;
+	case PHY_INTERFACE_MODE_1000BASEX: return SPEED_1000;
+	default: return SPEED_1000;
+	}
+}
+
+static int sfp_module_config_optical(struct sfp_priv *pl, const unsigned long *advertising)
+{
+	DECLARE_PHY_INTERFACE_MASK(interfaces) = {};
+
+	if (1) {
+		if (linkmode_test_bit(ETHTOOL_LINK_MODE_10000baseCR_Full_BIT, advertising) ||
+		    linkmode_test_bit(ETHTOOL_LINK_MODE_10000baseT_Full_BIT, advertising) ||
+		    linkmode_test_bit(ETHTOOL_LINK_MODE_10000baseKR_Full_BIT, advertising) ||
+		    linkmode_test_bit(ETHTOOL_LINK_MODE_10000baseSR_Full_BIT, advertising) ||
+		    linkmode_test_bit(ETHTOOL_LINK_MODE_10000baseLR_Full_BIT, advertising))
+			__set_bit(PHY_INTERFACE_MODE_10GBASER, interfaces);
+
+		if (linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseX_Full_BIT, advertising) ||
+		    linkmode_test_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT, advertising))
+			__set_bit(PHY_INTERFACE_MODE_2500BASEX, interfaces);
+
+		if (linkmode_test_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT, advertising) ||
+		    linkmode_test_bit(ETHTOOL_LINK_MODE_1000baseX_Full_BIT, advertising))
+			__set_bit(PHY_INTERFACE_MODE_1000BASEX, interfaces);
+	} else {
+		for (int i = 0; i < ARRAY_SIZE(sfp_interface_preference); i++)
+			__assign_bit(sfp_interface_preference[i], interfaces,
+				     test_bit(sfp_interface_preference[i], pl->sfp_interfaces));
+	}
+
+	if (phy_interface_empty(interfaces)) {
+		pr_err("%s: unsupported SFP module: no common interface modes\n", sfp_priv_netdev_name(pl));
+		return -EINVAL;
+	}
+
+	for (int i = 0; i < ARRAY_SIZE(sfp_interface_preference); i++) {
+		if (test_bit(sfp_interface_preference[i], interfaces)) {
+			pl->link_config.interface = sfp_interface_preference[i];
+			pl->link_config.speed = sfp_iface_to_speed(pl->link_config.interface);
+			pl->link_config.duplex = 1;
+			pr_info("%s: switched to %s link mode\n", sfp_priv_netdev_name(pl), phy_modes(pl->link_config.interface));
+			pl->force_link_down_once = true;
+			break;
+		}
+	}
+
+	return 0;
+}
+
+static int sfp_module_insert(void *upstream, const struct sfp_eeprom_id *id)
+{
+	struct phy_device *phydev = upstream;
+	struct sfp_priv *pl = get_sfp_priv(phydev);
+
+	pl->module_present = true;
+
+	linkmode_zero(pl->sfp_support);
+	phy_interface_zero(pl->sfp_interfaces);
+	sfp_parse_support(phydev->sfp_bus, id, pl->sfp_support, pl->sfp_interfaces);
+
+	pl->sfp_may_have_phy = sfp_may_have_phy(phydev->sfp_bus, id);
+	if (pl->sfp_may_have_phy)
+		return 0;
+
+	linkmode_copy(phydev->supported, pl->sfp_support);
+	linkmode_copy(phydev->advertising, pl->sfp_support);
+
+	return sfp_module_config_optical(pl, phydev->advertising);
+}
+
+static int sfp_module_start(void *upstream)
+{
+	struct phy_device *phydev = upstream;
+	struct sfp_priv *pl = get_sfp_priv(phydev);
+
+	pr_debug("%s\n", __func__);
+
+	if (pl->phydev) {
+		phy_start(pl->phydev);
+		return 0;
+	}
+
+	if (!pl->sfp_may_have_phy)
+		return 0;
+
+	return sfp_module_config_optical(pl, phydev->advertising);
+}
+
+static void sfp_module_remove(void *upstream)
+{
+	struct phy_device *phydev = upstream;
+	struct sfp_priv *pl = get_sfp_priv(phydev);
+
+	pr_debug("%s\n", __func__);
+
+	pl->module_present = false;
+}
+
+static void sfp_module_stop(void *upstream)
+{
+	struct sfp_priv *pl = get_sfp_priv(upstream);
+
+	pr_debug("%s\n", __func__);
+	if (pl->phydev)
+		phy_stop(pl->phydev);
+}
+
+static void sfp_module_link_down(void *upstream)
+{
+	struct sfp_priv *pl = get_sfp_priv(upstream);
+
+	pl->link_config.link = 0;
+
+	pr_debug("%s\n", __func__);
+}
+
+static void sfp_module_link_up(void *upstream)
+{
+	struct sfp_priv *pl = get_sfp_priv(upstream);
+
+	if (!pl->phydev) {
+		pl->link_config.link = 1;
+		pl->link_config.speed = sfp_iface_to_speed(pl->link_config.interface);
+		pl->link_config.duplex = 1;
+	}
+
+	pr_debug("%s\n", __func__);
+}
+
+static int is_empty_linkmode(const unsigned long *linkmode)
+{
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(tmp) = { 0, };
+
+	phylink_set_port_modes(tmp);
+	phylink_set(tmp, Autoneg);
+	phylink_set(tmp, Pause);
+	phylink_set(tmp, Asym_Pause);
+
+	return linkmode_subset(linkmode, tmp);
+}
+
+static int validate(unsigned long *supported, const unsigned long *interfaces, struct phylink_link_state *state)
+{
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(all_adv) = { 0, };
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(all_s) = { 0, };
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(s);
+	struct phylink_link_state t;
+	int intf;
+
+	for (intf = 0; intf < PHY_INTERFACE_MODE_MAX; intf++) {
+		if (test_bit(intf, interfaces)) {
+			linkmode_copy(s, supported);
+
+			t = *state;
+			t.interface = intf;
+
+			phylink_validate_mask_caps(s, &t, mac_capabilities);
+			if (!is_empty_linkmode(s)) {
+				linkmode_or(all_s, all_s, s);
+				linkmode_or(all_adv, all_adv, t.advertising);
+			}
+		}
+	}
+
+	linkmode_copy(supported, all_s);
+	linkmode_copy(state->advertising, all_adv);
+
+	return is_empty_linkmode(supported) ? -EINVAL : 0;
+}
+
+static void sfp_set_config(struct phy_device *phydev, unsigned long *supported, struct phylink_link_state *state)
+{
+	struct sfp_priv *pl = get_sfp_priv(phydev);
+//	bool changed = false;
+
+	if (!linkmode_equal(pl->supported, supported)) {
+		linkmode_copy(pl->supported, supported);
+//		changed = true;
+	}
+
+	if (!linkmode_equal(pl->link_config.advertising, state->advertising)) {
+		linkmode_copy(pl->link_config.advertising, state->advertising);
+//		changed = true;
+	}
+
+	if (pl->link_config.interface != state->interface) {
+		pl->link_config.interface = state->interface;
+//		changed = true;
+		pr_info("%s: switched to %s link mode\n", sfp_priv_netdev_name(pl), phy_modes(state->interface));
+	}
+
+//	if (changed)
+//		sfp_mac_config(phydev);
+}
+
+static void sfp_phy_link_change(struct phy_device *phydev, bool up)
+{
+	struct sfp_priv *pl = (void *)phydev->phylink;
+
+	pl->link_config.link = up;
+	pl->link_config.speed = phydev->speed;
+	pl->link_config.duplex = phydev->duplex;
+
+	if (pl->link_config.interface != phydev->interface) {
+		pl->link_config.interface = phydev->interface;
+		pr_info("%s: switched to %s link mode\n", sfp_priv_netdev_name(pl), phy_modes(phydev->interface));
+	}
+}
+
+static int sfp_module_connect_phy(void *upstream, struct phy_device *phy)
+{
+	struct phy_device *phydev = upstream;
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(support1);
+	__ETHTOOL_DECLARE_LINK_MODE_MASK(support);
+	struct phylink_link_state config;
+	struct sfp_priv *pl = get_sfp_priv(phydev);
+	int err;
+
+	for (int i = 0; i < ARRAY_SIZE(sfp_interface_preference); i++)
+		__set_bit(sfp_interface_preference[i], phy->host_interfaces);
+
+	linkmode_copy(support, phy->supported);
+
+	memset(&config, 0, sizeof(config));
+	linkmode_copy(config.advertising, phy->advertising);
+	config.interface = PHY_INTERFACE_MODE_NA;
+	config.speed = SPEED_UNKNOWN;
+	config.duplex = DUPLEX_UNKNOWN;
+	config.pause = MLO_PAUSE_AN;
+
+	if (validate(support, phy->host_interfaces, &config)) {
+		pr_err("%s: validation with support %*pb failed\n", sfp_priv_netdev_name(pl), __ETHTOOL_LINK_MODE_MASK_NBITS, support);
+		return -EMEDIUMTYPE;
+	}
+
+	config.interface = sfp_select_interface(phydev->sfp_bus, config.advertising);
+	if (config.interface == PHY_INTERFACE_MODE_NA) {
+		pr_err("%s: selection of interface failed, advertisement %*pb\n", sfp_priv_netdev_name(pl), __ETHTOOL_LINK_MODE_MASK_NBITS, config.advertising);
+		return -EINVAL;
+	}
+
+	linkmode_copy(support1, support);
+	phylink_validate_mask_caps(support1, &config, mac_capabilities);
+	if (is_empty_linkmode(support1)) {
+		pr_err("%s: validation of %s with support %*pb failed\n", sfp_priv_netdev_name(pl), phy_modes(config.interface), __ETHTOOL_LINK_MODE_MASK_NBITS, support);
+		return -EINVAL;
+	}
+
+	sfp_set_config(phydev, support, &config);
+
+	/* phylink_attach_phy */
+	phy->interface = config.interface;
+	phy->phylink = (void *)pl;
+	phy->phy_link_change = sfp_phy_link_change;
+
+	err = phy_init_hw(phy);
+	if (err < 0)
+		return err;
+
+	phy_resume(phy);
+
+	/* phylink_bringup_phy */
+	pl->phydev = phy;
+
+	linkmode_copy(phydev->supported, phy->supported);
+	linkmode_copy(phydev->advertising, phy->advertising);
+
+	return 0;
+}
+
+static void sfp_module_disconnect_phy(void *upstream)
+{
+	struct sfp_priv *pl = get_sfp_priv(upstream);
+	struct phy_device *phy = pl->phydev;
+
+	pl->phydev = NULL;
+
+	phy_suspend(phy);
+	phy->phylink = NULL;
+
+	pr_debug("%s\n", __func__);
+}
+
+static const struct sfp_upstream_ops sfp_upstream_ops = {
+	.attach = phy_sfp_attach,
+	.detach = phy_sfp_detach,
+	.module_insert = sfp_module_insert,
+	.module_remove = sfp_module_remove,
+	.module_start = sfp_module_start,
+	.module_stop = sfp_module_stop,
+	.link_down = sfp_module_link_down,
+	.link_up = sfp_module_link_up,
+	.connect_phy = sfp_module_connect_phy,
+	.disconnect_phy = sfp_module_disconnect_phy,
+};
