[ -e /etc/config/ubootenv ] || touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
cznic,ipq9574-turris-omnia-ng)
    ubootenv_add_uci_config "/dev/mtd$(find_mtd_index 0:APPSBLENV)" "0x0" 0x10000 0x10000
    ;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config ubootenv

exit 0
